---
import BaseLayout from "../layouts/BaseLayout.astro";
import AppStoreBadge from "../components/AppStoreBadge.astro";
import GooglePlayBadge from "../components/GooglePlayBadge.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import RateDisclosure from "../components/RateDisclosure.astro";
import { coverage } from "../lib/rates";
import { corridors } from "../lib/corridors";

const countries = await coverage();
import {
  voipRestrictedPricedDestinations,
  formatRate,
  fromPrefix,
} from "../lib/rates";

// Evergreen explainer for the "WhatsApp calls blocked in the Gulf" query.
// Claims are kept hedged and dateless: some Gulf countries restrict voice
// calls on many internet apps; it varies and can change. Kalum's angle is
// framed positively — it dials a regular phone number, so it doesn't depend
// on those apps — never as circumventing a restriction. The country list is
// data-driven from the `voipRestricted` flag so it stays in sync with the
// destination pages.
const { card, priced: restricted } = await voipRestrictedPricedDestinations();
const from = fromPrefix(card.basis);

const faqs = [
  {
    q: "Why can't I make WhatsApp calls in the UAE or Qatar?",
    a: "Some Gulf countries restrict voice and video calls on many internet apps. Where that applies, app-to-app calls may not connect even when messaging and the rest of the internet still work. It varies by country and can change over time.",
  },
  {
    q: "Does Kalum work where internet calls are restricted?",
    a: "Kalum doesn't place an app-to-app internet call. It uses your connection to dial a regular phone number over the phone network, so the call reaches any landline or mobile — the person you call needs no app and no internet on their end.",
  },
  {
    q: "Do I need a VPN?",
    a: "Not for Kalum. It places a regular phone call to a normal number rather than an internet app call, so there's nothing to configure on your side — you just dial and it rings.",
  },
  {
    q: "How much does it cost to call the Gulf?",
    a: "Rates are per-country and you see the exact per-minute rate before you dial. You add prepaid credit starting from $4.99 — no subscription, and your credit never expires.",
  },
];

/**
 * Titled for what Search Console says this page is actually found on, not for
 * the topic it was written about. Over the three months to 2026-08-30 it took
 * 46 named-query impressions: 43 were "gulf calling app" and "gulf call app"
 * at position 8.5, and 3 were about WhatsApp. Every one earned zero clicks.
 * A reader searching for a calling app was being handed a question they
 * already knew the answer to.
 *
 * The restriction copy stays in the body — it is true, it is why this page
 * exists, and it is the differentiator. It just stops being the headline.
 * The URL does not move: it is indexed and it is what holds the position.
 */
// "gulf calling app" is the exact phrase this page is found on, so it leads
// verbatim. The UAE and Qatar move to the description, which has the room.
const title = "Gulf Calling App for the UAE & Qatar | Kalum";
const description =
  "A calling app for the Gulf that dials a regular phone number instead of an internet call — so it connects where app calls are restricted, with no app or internet needed on their end.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://kalum.app/whatsapp-calls-blocked/"
>
  <!-- Hero -->
  <section class="brand-gradient relative overflow-hidden text-white">
    <div class="absolute inset-0 opacity-[0.07]" aria-hidden="true">
      <div class="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-white blur-3xl"></div>
      <div class="absolute bottom-0 right-0 h-96 w-96 rounded-full bg-[var(--color-teal)] blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-4xl px-5 py-20 md:px-8 md:py-28">
      <Breadcrumb items={[{ name: "Home", href: "/" }, { name: "Calling in the Gulf" }]} />
      <p class="eyebrow text-[var(--color-teal-light)]">
        When internet calls won't connect
      </p>
      <h1 class="mt-5 text-4xl font-extrabold leading-[1.05] tracking-display sm:text-5xl lg:text-6xl">
        A calling app for the Gulf that dials real numbers.
        <span class="block text-white/85">So it rings, even when app calls don't.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85 sm:text-xl">
        In several Gulf countries, voice and video calls on many internet apps
        are restricted. Kalum doesn't rely on those apps — it dials a regular
        phone number over the phone network, so the person you're calling just
        picks up.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <AppStoreBadge size="lg" utm="kalum-web-whatsapp-blocked" />
        <GooglePlayBadge size="lg" utm="kalum-web-whatsapp-blocked" />
      </div>

      <p class="mt-5 text-sm text-white/70">
        Start with $4.99. No subscription. Credit never expires.
      </p>
    </div>
  </section>

  <!-- Why internet calls get blocked -->
  <section class="bg-white py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-5 md:px-8">
      <h2 class="text-3xl font-extrabold tracking-display text-[var(--color-text)] sm:text-4xl">
        Why the call won't connect — and why Kalum does
      </h2>
      <div class="mt-6 space-y-5 text-lg leading-relaxed text-[var(--color-muted)]">
        <p>
          Some countries restrict voice and video calls made over internet
          apps. Where that's the case, an app-to-app call can fail to connect
          even though chat messages and the rest of the internet still work.
          Which apps and which countries this affects varies, and it can
          change over time.
        </p>
        <p>
          Kalum works differently. It isn't an app-to-app internet call — it
          uses your connection to place a normal phone call to a real number,
          routed over regular phone networks. The person you reach doesn't use
          an app at all: their landline or mobile simply rings, the way any
          phone call does.
        </p>
        <p>
          You see the per-minute rate for their country before you dial, and
          calls are billed by the minute with a 60-second minimum.
          <a
            href="/how-it-works/"
            class="font-semibold text-[var(--color-maroon)] hover:text-[var(--color-maroon-light)] transition"
          >See how Kalum works &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Where this comes up -->
  <section class="bg-[var(--color-cream)] py-20 md:py-28">
    <div class="mx-auto max-w-4xl px-5 md:px-8">
      <h2 class="text-3xl font-extrabold tracking-display text-[var(--color-text)] sm:text-4xl">
        Calling the Gulf
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-muted)]">
        These are the destinations where callers most often run into internet
        app-call restrictions. With Kalum you dial the real number instead —
        landlines and mobiles alike, at the per-minute rate the app shows you
        before the call starts.
      </p>

      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          restricted.map((d) => (
            <li>
              <a
                href={`/call/${d.slug}/`}
                class="flex items-center justify-between gap-4 rounded-2xl border border-black/5 bg-white p-5 shadow-sm transition hover:border-[var(--color-maroon)]/40 hover:shadow-md"
              >
                <span class="text-lg font-bold text-[var(--color-text)]">
                  Call {d.name}
                </span>
                <span class="shrink-0 text-right">
                  {from && (
                    <span class="micro-label block text-[var(--color-muted)]">
                      from
                    </span>
                  )}
                  <span class="text-2xl font-extrabold tabular-nums text-[var(--color-maroon)]">
                    {formatRate(d.rateCents)}<span class="text-sm font-semibold text-[var(--color-muted)]">/min</span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <RateDisclosure card={card} class="mt-6" />

      <p class="mt-8 text-base text-[var(--color-muted)]">
        Comparing your options?
        <a
          href="/calling-app-vs-internet-calling/"
          class="font-semibold text-[var(--color-maroon)] hover:text-[var(--color-maroon-light)] transition"
        >Calling app vs internet calling apps &rarr;</a>
      </p>
    </div>
  </section>

  <!--
    Calling OUT of a restricted market.

    The cards above serve calling INTO the Gulf; these serve being there and
    calling home, which is the more common version of the problem and the one
    the corridor pages were written for. They belong here on the merits, and
    this page is also the best link source on the site for them: it is
    footer-linked sitewide, carries 42 inbound links, and Google crawls it
    daily. The corridor pages had one inbound link each and one of them had
    never been crawled at all. See src/lib/corridors.ts.
  -->
  <section class="bg-white py-20 md:py-28">
    <div class="mx-auto max-w-4xl px-5 md:px-8">
      <h2 class="text-3xl font-extrabold tracking-display text-[var(--color-text)] sm:text-4xl">
        Calling home from the Gulf
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-muted)]">
        If you are the one in a country where app calls are restricted, these
        pages cover dialling out — the codes, the number formats, and what each
        route costs.
      </p>

      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          corridors.map((c) => (
            <li>
              <a
                href={c.path}
                class="block h-full rounded-2xl border border-black/5 bg-[var(--color-cream)] p-6 transition hover:border-[var(--color-maroon)]/40 hover:shadow-md"
              >
                <span class="block text-lg font-bold text-[var(--color-text)]">
                  {c.label} &rarr;
                </span>
                <span class="mt-2 block text-base leading-relaxed text-[var(--color-muted)]">
                  {c.blurb}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-5 md:px-8">
      <h2 class="text-3xl font-extrabold tracking-display text-[var(--color-text)] sm:text-4xl">
        Common questions
      </h2>

      <ul class="mt-10 divide-y divide-black/10 border-y border-black/10">
        {
          faqs.map((faq) => (
            <li>
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-semibold text-[var(--color-text)]">
                  <span>{faq.q}</span>
                  <span
                    aria-hidden="true"
                    class="mt-1 shrink-0 text-2xl font-light text-[var(--color-maroon)] transition-transform group-open:rotate-45"
                  >
                    +
                  </span>
                </summary>
                <p class="mt-3 pr-10 text-base leading-relaxed text-[var(--color-muted)]">
                  {faq.a}
                </p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="brand-gradient text-white">
    <div class="mx-auto max-w-3xl px-5 py-16 text-center md:px-8 md:py-20">
      <h2 class="text-3xl font-extrabold tracking-display sm:text-4xl">
        Reach them on a real phone.
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-white/85">
        Download Kalum, add $4.99 in credit, and dial any landline or mobile in
        {countries}+ countries. Pay only for the minutes you use.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <AppStoreBadge size="lg" utm="kalum-web-whatsapp-blocked" />
        <GooglePlayBadge size="lg" utm="kalum-web-whatsapp-blocked" />
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>
