---
// The Spanish home page is the English home page with locale="es" — same
// eight sections, same order, same components. Every word it shows lives in
// HOME_COPY.es (src/lib/home-copy.ts). Nothing but the head metadata is
// written here, and that is the point: this file used to be hand-written
// markup, which is how it ended up without the hero screenshot, the trust
// strip and the destinations grid while the English page had all three.
// scripts/check-parity.mjs now fails the build if the two pages stop
// rendering the same set of sections.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/home/Hero.astro";
import RateFinderSection from "../../components/home/RateFinderSection.astro";
import NoInternet from "../../components/home/NoInternet.astro";
import HowItWorksTeaser from "../../components/home/HowItWorksTeaser.astro";
import PopularDestinations from "../../components/home/PopularDestinations.astro";
import TrustStrip from "../../components/home/TrustStrip.astro";
import HomeFAQ from "../../components/home/HomeFAQ.astro";
import FinalCTA from "../../components/home/FinalCTA.astro";
import { alternatesFor } from "../../lib/i18n";
import { coverage } from "../../lib/rates";

const countries = await coverage();
---

<BaseLayout
  title="Kalum: App de Llamadas Internacionales Baratas al Extranjero"
  description={`App de llamadas internacionales baratas: llama a fijos y celulares en más de ${countries} países. Sin app ni internet de su lado. Desde $4.99.`}
  canonical="https://kalum.app/es/"
  lang="es"
  alternates={alternatesFor("/es/")}
>
  <Hero locale="es" />
  <RateFinderSection locale="es" />
  <NoInternet locale="es" />
  <HowItWorksTeaser locale="es" />
  <PopularDestinations locale="es" />
  <TrustStrip locale="es" />
  <HomeFAQ locale="es" />
  <FinalCTA locale="es" />
</BaseLayout>
