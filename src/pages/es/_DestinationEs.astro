---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RateDisclosure from "../../components/RateDisclosure.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PageHero from "../../components/kit/PageHero.astro";
import HeroCopy from "../../components/kit/HeroCopy.astro";
import StoreBadges from "../../components/kit/StoreBadges.astro";
import HeroRateCard from "../../components/kit/RateCard.astro";
import Section from "../../components/kit/Section.astro";
import Steps from "../../components/kit/Steps.astro";
import Faq from "../../components/kit/Faq.astro";
import LinkChips from "../../components/kit/LinkChips.astro";
import CtaBand from "../../components/kit/CtaBand.astro";
import Arrow from "../../components/kit/Arrow.astro";
import {
  pricedDestination,
  pricedDestinations,
  formatRate,
  formatRatesAsOf,
  coverage,
} from "../../lib/rates";
import { alternatesFor } from "../../lib/i18n";
import {
  DESTINATION_COPY_ES,
  ES_NAMES,
  PRICE_LED_MAX_CENTS_ES,
} from "./_destinations-es";

// Shared body for the Spanish destination pages. Underscore-prefixed so Astro
// treats it as a component, not a route.
//
// The rate is single-sourced from the live card at build time, exactly as the
// English pages are, so /call/{slug}/ and /es/call/{slug}/ can never quote
// different prices. Prose comes from the per-locale table next door.
interface Props {
  slug: string;
}
const { slug } = Astro.props;

const copy = DESTINATION_COPY_ES[slug];
if (!copy) {
  throw new Error(`es/call/${slug}: no Spanish copy in _destinations-es.ts`);
}

const { card, destination: d } = await pricedDestination(slug);
if (!d) {
  // These routes are fixed: each is in the sitemap and is half of an hreflang
  // pair, so quietly skipping one would strand its English alternate. A row
  // missing from BOTH the live card and the committed snapshot is a data
  // fault, not a bad minute on the API.
  throw new Error(
    `es/call/${slug}: no rate for this destination in the live card or src/data/rates.json`
  );
}

const rate = formatRate(d.rateCents);
const asOf = formatRatesAsOf(card.fetchedAt, "es");
// "desde 6¢" for a cheapest-prefix floor, "por 6¢" for a fixed price.
const preposition = card.basis === "from" ? "desde" : "por";
const fromEs = card.basis === "from" ? "desde " : "";
const canonicalPath = `/es/call/${slug}/`;
const canonical = `https://kalum.app${canonicalPath}`;

/**
 * Sibling destinations, Spanish pages only.
 *
 * The English template has carried a "More destinations" block all along;
 * these pages never did, so until 2026-09-19 every Spanish destination page's
 * only outbound destination links came from the footer. Listing ONLY the
 * destinations that have a Spanish page keeps the reader in Spanish — the same
 * call `es/call/index.astro` documents for its own cards. The rest of the
 * world stays one click away through the hub link underneath.
 */
const countries = await coverage();
const { priced: allPriced } = await pricedDestinations();
const esSlugs = Object.keys(DESTINATION_COPY_ES);
const others = esSlugs
  .filter((o) => o !== slug)
  .map((o) => allPriced.find((x) => x.slug === o))
  .filter((x): x is NonNullable<typeof x> => Boolean(x));

// Same rule as the English pages: a price-led headline only works while the
// price is a selling point. Above the threshold the page leads with what the
// product does instead — the figure still appears below, in the FAQ and in
// the schema.
const priceLed = d.rateCents < PRICE_LED_MAX_CENTS_ES;

const headline = priceLed
  ? `Llama a ${copy.name} ${preposition} ${rate} el minuto.`
  : `Llama a cualquier teléfono en ${copy.name}.`;
const subhead = priceLed
  ? "Fijos y celulares. Solo contestan."
  : "Fijos y celulares. Sin app, sin smartphone y sin internet de su lado.";
const heroRateLine = `Actualmente ${fromEs}${rate} el minuto a cualquier número de ${copy.name}.`;

// Mirrors the English retitle in src/pages/call/[slug].astro, and for a
// stronger reason: in Spanish the number-format intent is not a slice of the
// tail, it is nearly the whole page. Every named query /es/call/honduras/ held
// over the three months to 2026-08-30 was a format question, three of the four
// in the top eleven, all of them at zero clicks.
const fullTitle = priceLed
  ? `Llamar a ${copy.name} desde ${rate}/min — Marca +${d.dialCode} | Kalum`
  : `Llamar a ${copy.name} — Marca +${d.dialCode}, Sin App de Su Lado | Kalum`;
// Spanish country names run longer than the English ones ("El Salvador" put
// this line at 61), and Google cuts around 60. The brand suffix is the part
// that can go: it is already in the H1, in og:site_name and in the visible
// domain. Drop it only when the line would otherwise be cut.
const title =
  fullTitle.length > 60 ? fullTitle.replace(/ \| Kalum$/, "") : fullTitle;

/**
 * Budgeted like the English template — see src/pages/call/[slug].astro for the
 * reasoning. It matters more here: in Spanish the number-format intent is
 * nearly the whole page, and `numberFormatShort` runs to 94 characters, so the
 * old single sentence pushed every one of these pages past the cut at 170-183.
 */
const DESCRIPTION_BUDGET = 150;

const descriptionTails = priceLed
  ? [
      ` Llama a ${copy.name} ${preposition} ${rate} por minuto — sin app ni internet de su lado.`,
      ` Llamadas ${preposition} ${rate}/min — sin app ni internet de su lado.`,
      ` Llamadas ${preposition} ${rate}/min, sin app de su lado.`,
    ]
  : [
      ` Llama a cualquier fijo o celular de ${copy.name} — sin app ni internet de su lado.`,
      ` Llama a cualquier fijo o celular, sin app de su lado.`,
      ` Sin app ni internet de su lado.`,
    ];

const description =
  copy.numberFormatShort +
  (descriptionTails.find(
    (tail) => copy.numberFormatShort.length + tail.length <= DESCRIPTION_BUDGET,
  ) ?? descriptionTails[descriptionTails.length - 1]);

const faqs = [
  {
    q: `¿Cuánto cuesta llamar a ${copy.name} con Kalum?`,
    a:
      card.basis === "from"
        ? `Desde ${rate} por minuto a cualquier número de ${copy.name} (vigente al ${asOf}). Un celular y un fijo pueden costar distinto, así que la app te muestra la tarifa exacta del número que marcas antes de llamar — esa es la que se cobra. Las llamadas se cobran por minuto, redondeando hacia arriba, con un mínimo de un minuto.`
        : `${rate} por minuto a cualquier número de ${copy.name} (vigente al ${asOf}). Las llamadas se cobran por minuto, redondeando hacia arriba, con un mínimo de un minuto, y siempre ves la tarifa actual en la app antes de marcar.`,
  },
  {
    q: `¿La persona en ${copy.name} necesita la app o internet?`,
    a: "No. Kalum pasa por las redes telefónicas reales, así que su teléfono suena como cualquier llamada normal. No necesita app, ni smartphone, ni internet — funciona hasta con un fijo o un teléfono básico.",
  },
  {
    q: `¿Puedo llamar a teléfonos fijos en ${copy.name}?`,
    a:
      card.basis === "from"
        ? `Sí. Kalum llama igual a fijos y a celulares en ${copy.name}, y quien contesta lo hace en el teléfono que ya tiene. La tarifa por minuto puede variar entre uno y otro, así que la app te muestra la tarifa exacta del número que marcas antes de que empiece la llamada.`
        : `Sí. Los fijos y los celulares en ${copy.name} cuestan lo mismo, ${rate} por minuto. A quien llames contesta en el teléfono que ya tiene.`,
  },
  {
    q: `¿Cómo llamo a ${copy.name} desde Estados Unidos?`,
    a: `Descarga Kalum en iPhone o Android, regístrate con tu número de teléfono y agrega saldo desde $4.99. Elige ${copy.name} (+${d.dialCode}) en el marcador, escribe el número local y llama.`,
  },
  {
    q: `¿Puedo llamar a ${copy.name} desde mi celular?`,
    a: `Sí. Kalum funciona en tu propio iPhone o Android, así que llamas a ${copy.name} directo desde tu celular por Wi-Fi o datos móviles. La persona contesta en el teléfono que ya tiene — sin app ni internet de su lado.`,
  },
  {
    q: `¿Cuál es el formato de los números en ${copy.name}?`,
    a: copy.numberFormatFaq,
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  lang="es"
  alternates={alternatesFor(canonicalPath)}
>
  <PageHero>
    <Breadcrumb
      items={[
        { name: "Inicio", href: "/es/" },
        { name: "Destinos", href: "/es/call/" },
        { name: copy.linkLabel },
      ]}
    />
    <HeroCopy eyebrow={`Llamando a ${copy.name} · +${d.dialCode}`} title={headline} accent={subhead} lead={copy.heroSubline} />
    {
      !priceLed && (
        <p class="mt-5 text-lg font-semibold text-white sm:text-xl">{heroRateLine}</p>
      )
    }
    <StoreBadges utm={`kalum-web-es-call-${slug}`} class="mt-8" />
    <HeroRateCard slot="card" name={copy.name} dialCode={d.dialCode} from={fromEs} rate={rate} card={card} locale="es" />
  </PageHero>

  <!--
    Number format first, and as an h2.
    It was an h3 buried inside "Cómo llamar" until 2026-09-19, while the
    English page had already promoted the same block to its own leading
    section. In Spanish the case is stronger, not weaker: every named query
    these pages hold is a format question ("numero de honduras", "número de
    guatemala"), all of them ranking 7-10 and taking no clicks.
  -->
  <Section section="number-format" width="mid">
    <div class="card p-6 md:p-10">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <h2 class="text-title tracking-display">{copy.numberFormat.title}</h2>
        <span class="dial-tag text-base">+{d.dialCode}</span>
      </div>
      <p class="text-lead mt-4 max-w-2xl text-[var(--color-ink-2)]">{copy.numberFormat.body}</p>
    </div>
  </Section>

  <!-- How to call -->
  <Section section="steps" title={`Cómo llamar a ${copy.name}`}>
    <Steps
      steps={[
        {
          title: "Descarga Kalum",
          body: "Descarga la app en iPhone o Android y regístrate con tu número. Un código de verificación — sin correo ni contraseña.",
        },
        {
          title: "Agrega saldo",
          body: "Empieza con $4.99 y recarga cuando quieras. Sin suscripción ni contrato — tu saldo nunca vence.",
        },
        {
          title: `Marca +${d.dialCode}`,
          body: `Elige ${copy.name} (+${d.dialCode}) en el marcador, escribe el número local y llama. Su teléfono suena como cualquier llamada.`,
        },
      ]}
    />
    <p class="mt-8 text-[var(--color-ink-2)]">
      ¿Llamas a alguien sin internet?
      <a href="/es/call-without-internet/" class="link inline-flex items-center gap-1">Así funciona una llamada sin internet de su lado <Arrow /></a>
    </p>
  </Section>

  <Section section="faq" width="narrow" title={`Llamar a ${copy.name}, sin dudas.`}>
    <Faq items={faqs} />
  </Section>

  <!-- More destinations -->
  <Section
    section="destinations"
    width="mid"
    title="Más destinos"
    lead={`Kalum llama a fijos y celulares en más de ${countries} países. Otros destinos con página en español:`}
  >
    <LinkChips
      items={others.map((o) => ({
        label: `${ES_NAMES[o.slug] ?? o.name} · ${fromEs}${formatRate(o.rateCents)}/min`,
        href: `/es/call/${o.slug}/`,
      }))}
    />
    <p class="mt-6">
      <a href="/es/call/" class="link inline-flex items-center gap-1.5">
        Ver todos los destinos y tarifas <Arrow />
      </a>
    </p>
  </Section>

  <CtaBand
    title={`¿Listo para llamar a ${copy.name}?`}
    body="Descarga Kalum, agrega $4.99 de saldo y marca. Pagas solo los minutos que usas."
    utm={`kalum-web-es-call-${slug}`}
  >
    <RateDisclosure card={card} locale="es" tone="dark" class="mx-auto mt-6 max-w-xl" />
  </CtaBand>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>
