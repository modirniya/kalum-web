---
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchLegal } from "../lib/legal";
import PageHero from "../components/kit/PageHero.astro";
import Section from "../components/kit/Section.astro";

const SOURCE = "https://legal.neuera.app/kalum/privacy/";
const { body, fetchedAt } = await fetchLegal(SOURCE);

const synced = new Date(fetchedAt).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title="Privacy Policy — Kalum"
  description="How Kalum handles your personal information when you make international calls."
  canonical={SOURCE}
  minimal
>
  <!-- Utility layout: a short wave header, the document in one white card. -->
  <PageHero variant="compact" width="narrow" class="!pb-2">
    <p class="eyebrow text-[var(--color-teal-light)]">Kalum</p>
  </PageHero>

  <Section width="narrow" class="!pt-0">
    <article class="card prose prose-lg relative z-10 -mt-16 max-w-none p-6 sm:p-10 md:-mt-20">
      <Fragment set:html={body} />
    </article>
    <p class="mt-8 text-sm leading-relaxed text-[var(--color-ink-2)]">
      Source of truth:
      <a href={SOURCE} class="link">legal.neuera.app/kalum/privacy</a>
      &mdash; last synced {synced}.
    </p>
  </Section>
</BaseLayout>
