---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/kit/PageHero.astro";
import Section from "../components/kit/Section.astro";
import StoreBadges from "../components/kit/StoreBadges.astro";

/*
 * Landing page for a Family Wallet invite link:
 *   https://www.kalum.app/join/?code=ABCD-EFGH
 *
 * The app has no universal links, so this page does the handing-over: it shows
 * the code big, lets the person copy it, and says where to enter it. The code is
 * read and rendered in the browser only — it is never sent anywhere, and the
 * page is noindex and absent from the sitemap. Cross-origin navigation (the
 * store badges) sends only our origin as the referrer, never the query.
 *
 * English and Spanish, like the app. The language follows the browser.
 */
---

<BaseLayout
  title="Join a Kalum family wallet"
  description="Someone invited you to their Kalum family wallet. Install Kalum, then enter the invite code in Settings → Family wallet."
  canonical="https://kalum.app/join/"
  noindex
>
  <PageHero variant="compact" width="narrow" class="text-center">
    <div class="mx-auto max-w-xl">
      <p class="eyebrow text-[var(--color-teal-light)]" data-i18n="eyebrow">Family wallet invite</p>
      <h1 class="text-title tracking-display mt-4 text-balance" data-i18n="title">
        You're invited to a Kalum family wallet
      </h1>
      <p class="text-lead mt-4 text-white/85" data-i18n="lede">
        The person who invited you lets you call on their Kalum balance. They will see how much
        you spend from it each month — not who you call.
      </p>
    </div>
  </PageHero>

  <Section width="narrow" class="!pt-8 md:!pt-10">
    <div class="card mx-auto max-w-xl p-6 text-center sm:p-8">
      <div id="code-box" class="hidden">
        <p class="micro-label text-[var(--color-ink-2)]" data-i18n="yourCode">Your invite code</p>
        <p
          id="code"
          class="mt-3 select-all rounded-xl bg-[var(--color-surface-2)] px-4 py-5 font-mono text-4xl font-bold tracking-widest md:text-5xl"
          dir="ltr"
        >
        </p>
        <button
          id="copy"
          type="button"
          class="btn btn-outline mt-4 rounded-full"
          data-i18n="copy"
        >
          Copy code
        </button>
        <p id="copied" class="mt-2 h-5 text-sm font-semibold text-[var(--color-link)]" aria-live="polite"></p>
      </div>

      <p id="no-code" class="hidden text-[var(--color-ink-2)]" data-i18n="noCode">
        This link has no invite code. Ask the person who invited you to send it again.
      </p>

      <ol class="mt-6 space-y-3 border-t border-[var(--color-outline)] pt-6 text-start">
        <li class="flex gap-3">
          <span aria-hidden="true" class="grid size-7 shrink-0 place-items-center rounded-full bg-[var(--color-primary)] text-sm font-bold text-[var(--color-on-primary)]">1</span>
          <span class="pt-0.5" data-i18n="step1">Install Kalum.</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="grid size-7 shrink-0 place-items-center rounded-full bg-[var(--color-primary)] text-sm font-bold text-[var(--color-on-primary)]">2</span>
          <span class="pt-0.5" data-i18n="step2">Open it and go to Settings → Family wallet → Join with a code.</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="grid size-7 shrink-0 place-items-center rounded-full bg-[var(--color-primary)] text-sm font-bold text-[var(--color-on-primary)]">3</span>
          <span class="pt-0.5" data-i18n="step3">Enter the code above (or paste this link) and accept.</span>
        </li>
      </ol>

      <StoreBadges utm="family-invite" size="md" align="center" class="mt-8" />

      <p class="mt-6 text-sm text-[var(--color-ink-2)]" data-i18n="expiry">
        Invite codes work once and expire 48 hours after they are created.
      </p>
    </div>
  </Section>

  <script is:inline>
    (function () {
      var es = {
        eyebrow: "Invitación a la billetera familiar",
        title: "Te invitaron a una billetera familiar de Kalum",
        lede:
          "Quien te invitó te deja llamar con su saldo de Kalum. Verá cuánto gastas de él cada mes, pero no a quién llamas.",
        yourCode: "Tu código de invitación",
        copy: "Copiar código",
        copied: "Copiado",
        noCode:
          "Este enlace no tiene código de invitación. Pide a quien te invitó que lo envíe de nuevo.",
        step1: "Instala Kalum.",
        step2: "Ábrelo y ve a Ajustes → Billetera familiar → Unirme con un código.",
        step3: "Escribe el código de arriba (o pega este enlace) y acepta.",
        expiry: "Los códigos sirven una sola vez y vencen 48 horas después de crearse.",
      };
      var copiedText = "Copied";
      var lang = (navigator.language || "en").toLowerCase();
      if (lang.indexOf("es") === 0) {
        document.documentElement.lang = "es";
        document.querySelectorAll("[data-i18n]").forEach(function (el) {
          var t = es[el.getAttribute("data-i18n")];
          if (t) el.textContent = t;
        });
        copiedText = es.copied;
      }

      // Only the characters a code can hold; anything else is dropped, and
      // it is written as text, never as HTML.
      var raw = new URLSearchParams(location.search).get("code") || "";
      var clean = raw.toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 8);
      if (clean.length === 8) {
        var shown = clean.slice(0, 4) + "-" + clean.slice(4);
        document.getElementById("code").textContent = shown;
        document.getElementById("code-box").classList.remove("hidden");
        document.getElementById("copy").addEventListener("click", function () {
          if (navigator.clipboard) {
            navigator.clipboard.writeText(shown).then(function () {
              document.getElementById("copied").textContent = copiedText;
            });
          }
        });
      } else {
        document.getElementById("no-code").classList.remove("hidden");
      }
    })();
  </script>
</BaseLayout>
