---
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchLegal } from "../lib/legal";

const SOURCE = "https://legal.neuera.app/kalum/terms/";
const { body, fetchedAt } = await fetchLegal(SOURCE);

const synced = new Date(fetchedAt).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title="Terms of Service — Kalum"
  description="Terms of use for Kalum, a prepaid international calling service."
  canonical={SOURCE}
>
  <section class="bg-[var(--color-cream)] py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-5 md:px-8">
      <article class="prose prose-lg">
        <Fragment set:html={body} />
      </article>
      <p class="mt-12 border-t border-black/10 pt-6 text-xs leading-relaxed text-[var(--color-muted)]">
        Source of truth:
        <a
          href={SOURCE}
          class="font-semibold text-[var(--color-maroon)] hover:text-[var(--color-maroon-light)]"
        >
          legal.neuera.app/kalum/terms
        </a>
        &mdash; last synced {synced}.
      </p>
    </div>
  </section>
</BaseLayout>
