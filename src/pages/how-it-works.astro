---
import BaseLayout from "../layouts/BaseLayout.astro";
import { alternatesFor } from "../lib/i18n";
import Steps from "../components/howitworks/Steps.astro";
import FAQ from "../components/howitworks/FAQ.astro";
import GooglePlayBadge from "../components/GooglePlayBadge.astro";
import AppStoreBadge from "../components/AppStoreBadge.astro";
import SignupOrigins from "../components/SignupOrigins.astro";
---

<BaseLayout
  title="How Kalum Works — Cheap Calls With No App for Recipients"
  description="Sign up with your number, add $4.99 in credit, dial any phone. The person you call doesn't need an app or internet — they just pick up."
  canonical="https://kalum.app/how-it-works/"
  alternates={alternatesFor("/how-it-works/")}
>
  <Steps />
  <FAQ />

  <section class="brand-gradient text-white">
    <div class="mx-auto max-w-3xl px-5 py-20 text-center md:px-8 md:py-24">
      <h2 class="text-3xl font-extrabold tracking-display sm:text-4xl">
        Ready to make your first call?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white/85">
        Available on iPhone and Android.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <AppStoreBadge size="lg" utm="kalum-web-howitworks" />
        <GooglePlayBadge size="lg" utm="kalum-web-howitworks" />
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-cream)] py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-5 md:px-8">
      <SignupOrigins />
    </div>
  </section>
</BaseLayout>
