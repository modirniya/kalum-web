---
import BaseLayout from "../layouts/BaseLayout.astro";
import Steps from "../components/howitworks/Steps.astro";
import FAQ from "../components/howitworks/FAQ.astro";
import GooglePlayBadge from "../components/GooglePlayBadge.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
---

<BaseLayout
  title="How Kalum Works — Cheap Calls With No App for Recipients"
  description="Sign up with your number, add $2 in credit, dial any phone. The person you call doesn't need an app or internet — they just pick up."
  canonical="https://www.kalum.app/how-it-works"
>
  <Steps />
  <FAQ />

  <section class="brand-gradient text-white">
    <div class="mx-auto max-w-3xl px-5 py-20 text-center md:px-8 md:py-24">
      <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
        Ready to make your first call?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white/85">
        Available now on Android. iPhone coming soon.
      </p>

      <div class="mt-8 flex justify-center">
        <GooglePlayBadge size="lg" utm="kalum-web-howitworks" />
      </div>

      <div class="mx-auto mt-12 max-w-lg rounded-2xl border border-white/10 bg-white/5 p-6 text-left backdrop-blur-sm">
        <h3 class="text-lg font-bold">On iPhone?</h3>
        <p class="mt-1 text-sm text-white/80">
          Drop your email and we'll send one message when Kalum is on the App Store.
        </p>
        <div class="mt-4">
          <WaitlistForm variant="dark" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
