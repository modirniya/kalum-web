---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/kit/PageHero.astro";
import HeroCopy from "../components/kit/HeroCopy.astro";
---

<BaseLayout
  title="Page not found — Kalum"
  description="The page you were looking for doesn't exist."
  canonical="https://kalum.app/404/"
  noindex={true}
>
  <PageHero variant="compact" class="text-center">
    <div class="mx-auto max-w-lg pb-6 pt-6 md:pt-10">
      <HeroCopy
        eyebrow="404"
        title="That page doesn't exist."
        lead="Try the home page or learn how Kalum works."
      />
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/" class="btn btn-pill w-full sm:w-auto">Home</a>
        <a href="/how-it-works/" class="btn btn-ghost-light w-full sm:w-auto">How it works</a>
      </div>
    </div>
  </PageHero>
  <div class="h-24 md:h-32" aria-hidden="true"></div>
</BaseLayout>
