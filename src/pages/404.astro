---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found — Kalum"
  description="The page you were looking for doesn't exist."
  canonical="https://kalum.app/404/"
  noindex={true}
>
  <section class="flex items-center justify-center bg-[var(--color-cream)] py-32 md:py-40">
    <div class="mx-auto max-w-lg px-5 text-center md:px-8">
      <p class="eyebrow text-[var(--color-maroon)]">
        404
      </p>
      <h1 class="mt-3 text-4xl font-extrabold leading-[1.05] tracking-display text-[var(--color-text)] sm:text-5xl">
        That page doesn't exist.
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-[var(--color-muted)]">
        Try the home page or learn how Kalum works.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/"
          class="rounded-md bg-[var(--color-maroon)] px-5 py-3 font-semibold text-white hover:bg-[var(--color-maroon-light)] transition"
        >
          Home
        </a>
        <a
          href="/how-it-works/"
          class="rounded-md border border-black/10 bg-white px-5 py-3 font-semibold text-[var(--color-text)] hover:bg-[var(--color-cream)] transition"
        >
          How it works
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
