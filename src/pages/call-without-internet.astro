---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import LanguageBar from "../components/LanguageBar.astro";
import RateDisclosure from "../components/RateDisclosure.astro";
import PageHero from "../components/kit/PageHero.astro";
import HeroCopy from "../components/kit/HeroCopy.astro";
import StoreBadges from "../components/kit/StoreBadges.astro";
import Section from "../components/kit/Section.astro";
import Faq from "../components/kit/Faq.astro";
import CtaBand from "../components/kit/CtaBand.astro";
import LinkChips from "../components/kit/LinkChips.astro";
import Arrow from "../components/kit/Arrow.astro";
import { pricedDestinations, formatRate, fromPrefix } from "../lib/rates";
import { alternatesFor } from "../lib/i18n";
import { coverage } from "../lib/rates";

const countries = await coverage();

// Evergreen page for the core differentiator: the person you call needs no
// internet, app, or smartphone. Copy stays within verified claims.

// The destinations strip prices itself from the live rate card at build time.
const { card, priced } = await pricedDestinations();
const from = fromPrefix(card.basis);

const faqs = [
  {
    q: "Can I call someone who has no internet at all?",
    a: "Yes. Kalum routes your call through real phone networks, so the person you call needs no internet, no app, and no smartphone. An old landline or a basic feature phone rings like it would for any normal call.",
  },
  {
    q: "Do I need internet to make the call?",
    a: "Yes — on your end only. The Kalum app uses your data or Wi-Fi to start the call, then hands it over to regular phone networks. The person you call never needs a connection.",
  },
  {
    q: "Can I call landlines?",
    a: `Yes. Kalum calls landlines and mobiles in ${countries}+ countries. Whoever you call answers on whatever phone they already have — nothing to download, nothing to set up on their side.`,
  },
  {
    q: "What does it cost?",
    a: "Rates are per-country, and the app shows the exact per-minute rate before you dial. You add prepaid credit starting from $4.99 — no subscription, and your credit never expires.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};

const reasons = [
  {
    title: "Landline-only households",
    body: "Parents and grandparents who never moved past the home phone. Their landline can't install an app — with Kalum it doesn't have to.",
  },
  {
    title: "Feature phones",
    body: "Plenty of the world still calls from phones with buttons. Any number on any carrier rings, no smartphone required.",
  },
  {
    title: "Unreliable internet",
    body: "Power cuts, weak coverage, expensive data. When the internet on their side is down, a regular phone call still gets through.",
  },
];
---

<BaseLayout
  title="Call Someone Without Internet — Their Phone Just Rings"
  description={`Call people with no internet, no smartphone and no apps. Kalum uses real phone networks, so any landline or feature phone in ${countries}+ countries just rings.`}
  canonical="https://kalum.app/call-without-internet/"
  alternates={alternatesFor("/call-without-internet/")}
>
  <PageHero>
    <Breadcrumb items={[{ name: "Home", href: "/" }, { name: "Call without internet" }]} />
    <HeroCopy
      eyebrow="No internet needed on their side"
      title="Call people who don't have internet."
      accent="Their phone just rings."
      lead={`Kalum is an international calling app that reaches real phone numbers — landlines and mobiles in ${countries}+ countries. The person you call needs no app, no smartphone, and no internet.`}
    />
    <StoreBadges utm="kalum-web-no-internet" class="mt-8" />
    <p class="mt-4 text-sm text-white/70">
      Start with $4.99. No subscription. Credit never expires.
    </p>
    <LanguageBar path="/call-without-internet/" label="Also in:" tone="light" class="mt-6" />
  </PageHero>

  <!-- How it reaches a phone with no internet -->
  <Section section="explainer" width="narrow" title="You need internet. They don't.">
    <div class="text-lead space-y-5 text-[var(--color-ink-2)]">
      <p>
        Internet calling apps only work when both sides are online with the
        same app installed. Kalum works differently: the app uses your data
        or Wi-Fi to start the call, then routes it through regular phone
        networks to the number you dialed.
      </p>
      <p>
        From the other person's side, nothing changes. Their phone rings
        like any other call — whether it's a landline on a kitchen wall or
        a feature phone from fifteen years ago. They pick up, and you talk.
      </p>
      <p>
        You see the per-minute rate for their country before you dial, and
        calls are billed by the minute with a 60-second minimum. No
        connection fees, no hidden charges.
        <a href="/how-it-works/" class="link inline-flex items-center gap-1">See how Kalum works <Arrow /></a>
      </p>
    </div>
  </Section>

  <!-- Who this is for -->
  <Section section="reasons" title="Made for the phones apps forgot." align="center">
    <div class="grid gap-4 md:grid-cols-3">
      {
        reasons.map((reason) => (
          <div class="card p-6 md:p-7">
            <h3 class="text-heading">{reason.title}</h3>
            <p class="mt-2 leading-relaxed text-[var(--color-ink-2)]">{reason.body}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-8 text-center text-[var(--color-ink-2)]">
      Comparing options?
      <a href="/calling-app-vs-internet-calling/" class="link inline-flex items-center gap-1">Calling app vs internet calling apps <Arrow /></a>
    </p>
  </Section>

  <Section section="faq" width="narrow" title="Calling without internet, answered.">
    <Faq items={faqs} />
  </Section>

  <!-- Destinations strip -->
  <Section
    section="destinations"
    width="mid"
    title="Popular destinations"
    lead="Per-minute rates to landlines and mobiles:"
  >
    <LinkChips
      items={priced.map((d) => ({
        label: `${d.name} · ${from}${formatRate(d.rateCents)}/min`,
        href: `/call/${d.slug}/`,
      }))}
    />
    <RateDisclosure card={card} class="mt-6" />
  </Section>

  <CtaBand
    title="Ready to call?"
    body={`Download Kalum, add $4.99 in credit, and dial any phone in ${countries}+ countries. Pay only for the minutes you use.`}
    utm="kalum-web-no-internet"
  />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>
