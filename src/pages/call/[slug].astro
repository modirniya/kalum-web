---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppStoreBadge from "../../components/AppStoreBadge.astro";
import GooglePlayBadge from "../../components/GooglePlayBadge.astro";
import RateDisclosure from "../../components/RateDisclosure.astro";
import { featuredSlugs, nameAtSentenceStart } from "../../lib/destinations";
import { corridorsFrom, corridorsTo } from "../../lib/corridors";
import {
  pricedDestinations,
  formatRate,
  fromPrefix,
  formatRatesAsOf,
  type PricedDestination,
  type RateCard,
} from "../../lib/rates";
import { alternatesFor } from "../../lib/i18n";
import { coverage } from "../../lib/rates";

const countries = await coverage();

// Organic destination pages — indexable, unlike the /call-mexico paid LP.
// Rates are fetched from the live rate card while the site builds and baked
// into this HTML (src/lib/rates.ts); copy stays within verified claims.
//
// Under prefix pricing the card gives a country's CHEAPEST prefix, so every
// figure here is a floor, not a flat price: the phrasing switches to "from
// X/min" and nothing claims one rate covers the country's mobiles and
// landlines. Rendering a "from" figure as flat would let this page contradict
// the quote the app gives before the call — the one number that gets billed.

/**
 * How many sibling destinations the "More destinations" block links to.
 *
 * This used to be "all of them". With 31 destination pages each linking to the
 * other 30, internal authority spread perfectly evenly across a set in which
 * every member ranked 29-42, and nothing was ever elevated — an audit measured
 * 32 sibling links per page. Link equity divides: pointing at everything is
 * the same as pointing at nothing, and it is why the /call/ hub itself sits at
 * position 28.9 while its children sit below it.
 *
 * The replacement is deliberate rather than exhaustive: same-region neighbours
 * first, because that is the block a human actually finds useful, then the
 * featured destinations to top up. Both are sets we want ranking, and the
 * long tail stays reachable through the /call/ hub and the sitemap — it just
 * stops diluting every page on the site.
 */
export async function getStaticPaths() {
  // Declared INSIDE getStaticPaths on purpose. Astro extracts this function
  // into its own isolated scope at build time, so it cannot see frontmatter
  // consts declared above it — a module-level `const RELATED_LIMIT` type-checks
  // clean and then fails the build with "RELATED_LIMIT is not defined".
  const RELATED_LIMIT = 8;

  const { card, priced } = await pricedDestinations();
  const featured = new Set(featuredSlugs);

  return priced.map((destination) => {
    const rest = priced.filter((o) => o.slug !== destination.slug);
    const sameRegion = rest.filter((o) => o.region === destination.region);
    const topUp = rest.filter(
      (o) => o.region !== destination.region && featured.has(o.slug),
    );
    // Region-mates first, then featured from elsewhere; dedupe by slug and cap.
    const others = [...sameRegion, ...topUp].slice(0, RELATED_LIMIT);

    return {
      params: { slug: destination.slug },
      props: { destination, card, others },
    };
  });
}

interface Props {
  destination: PricedDestination;
  card: RateCard;
  others: PricedDestination[];
}

const { destination: d, card, others } = Astro.props;
const rate = formatRate(d.rateCents);
const from = fromPrefix(card.basis);
const asOf = formatRatesAsOf(card.fetchedAt);
// "Call Mexico from 6¢ a minute" vs "…for 6¢ a minute" — a floor takes "from",
// a fixed price takes "for".
const preposition = card.basis === "from" ? "from" : "for";

/**
 * Above this, the page stops leading with the price.
 *
 * A price-led headline only works while the price is a selling point. "Call
 * Mexico from 4¢ a minute" sells; "Call Sudan from 87¢ a minute" is an
 * anti-hook, and dynamic pricing moves corridors across that line without
 * anyone editing a page. The old rule was all-or-nothing — Somalia was left
 * unpublished at $1.10 — and the roadmap said to revisit it "only with a
 * connectivity-led hero variant, not a plain data row". This is that variant.
 *
 * It changes what the page LEADS with, never what it discloses: the exact
 * figure stays in the hero, the FAQ, the schema and the cross-links. Hiding a
 * price to win a click is the trust failure this whole section exists to
 * avoid. Tune the one number below to move the boundary.
 *
 * 2026-08-08 — lowered 50 -> 10 on competitive evidence. Every SERP we rank
 * 4-10 on is a price comparison with rival rates visible in the snippet, and
 * we lose all of them: Turkey 9c vs 1.9c, Jordan 32c vs 4c, Saudi 21c vs 10.9c,
 * Iraq 51c vs 20.5c. At zero margin we still could not match, because Twilio's
 * cost to us exceeds their retail. At 50c, 30 of 31 pages led with a number
 * that loses the comparison before the click. Below 10c we are genuinely
 * competitive (Mexico 3c, UK 3c, India 7c) and the price is worth leading on;
 * above it, the honest hook is the thing rivals cannot match — the person you
 * call needs no app, no smartphone and no internet.
 *
 * Raise this again once multi-provider least-cost routing lands and the rates
 * are competitive. The price becoming a selling point again is the signal.
 */
const PRICE_LED_MAX_CENTS = 10;
const priceLed = d.rateCents < PRICE_LED_MAX_CENTS;

// What the page leads with instead, when the price isn't the story. Both lines
// are claims the site already makes and can back — no per-country research
// smuggled in, and nothing that stops being true when a rate moves again.
const valueSubline = d.voipRestricted
  ? `Voice calls on many internet apps are restricted there. Kalum dials the real number.`
  : `Landlines and mobiles. No app, smartphone, or internet on their end.`;

// Assembled here rather than interpolated in the markup: adjacent expressions
// inside a JSX fragment lose the whitespace between them, which silently
// welded the headline into "Call Mexicofrom4¢ a minute".
const headline = priceLed
  ? `Call ${d.name} ${preposition} ${rate} a minute.`
  : `Call any ${d.demonym} phone.`;
const subhead = priceLed
  ? "Landlines and mobiles. They just pick up."
  : valueSubline;
const heroRateLine = `Currently ${from}${rate} a minute to any ${d.demonym} number.`;

/**
 * Both titles lead with "Call {country}" because that is what these pages are
 * actually found on. Over the three months to 2026-08-30 the biggest queries
 * on the whole destination tree were `call turkey` (60 impressions, position
 * 13.2), `call omani` (47, 9.1), `call jordan` (43, 24.9) and `call egypt`
 * (34, 28.6) — and the page-one ones took zero clicks: `call bahrain` at 7.3,
 * `call ethiopia` at 6.2, `call omani` at 9.1, all nil.
 *
 * The old value-led title spent the rest of the line on "Rates and How to
 * Dial" — 26 pages sharing one generic string, leading with the word for the
 * intent this site loses (a rate comparison) ahead of the one it wins.
 *
 * What replaces it is the dial code plus the differentiator. The dial code
 * because a thin but real slice of the tail asks what a number there looks
 * like, and we rank for it already with nothing in the snippet that answers:
 * `turkey mobile number digits` at position 1, `010 egypt number` at 8.8,
 * `jordan phone number format` at 11, `oman mobile number digits` at 16. "No
 * app on their end" because it is the one claim a rival rate page cannot copy.
 *
 * Longest render is 60 characters (the Philippines), inside Google's cut.
 */
const title = priceLed
  ? `Call ${d.name} from ${rate}/min — Dial +${d.dialCode} | Kalum`
  : `Call ${d.name} — Dial +${d.dialCode}, No App on Their End | Kalum`;

/**
 * The description leads with the number-format fact rather than the pitch.
 * `numberFormat` is a one-clause restatement of `dialingNote`, so the snippet
 * answers the dialing question in the SERP instead of promising a rate the
 * reader can already see beaten in the result above ours.
 */
const description = priceLed
  ? `${d.numberFormat} Call ${d.name} ${preposition} ${rate} a minute with Kalum — no app or internet on their end.`
  : `${d.numberFormat} Call any ${d.demonym} landline or mobile with Kalum — no app or internet on their end.`;

/**
 * Corridor cross-links, kept as two lists because they address opposite
 * readers and cannot share a heading. On `/call/uae/` the corridors START
 * there — that reader may be the caller, in the Gulf, dialling out. On
 * `/call/india/` and `/call/pakistan/` the corridor ENDS there, and the reader
 * is the one being called from the Gulf. Most destinations have neither and
 * render nothing.
 *
 * This is half of the fix for the corridor cluster being effectively orphaned
 * — see src/lib/corridors.ts. It is also just correct on its own terms: a
 * reader on /call/india/ who happens to be in Dubai wants that page.
 */
const corridorsOut = corridorsFrom(d.slug);
const corridorsIn = corridorsTo(d.slug);

const canonical = `https://kalum.app/call/${d.slug}/`;
/** Dollars-per-minute, the form schema.org wants. */
const priceUsd = (d.rateCents / 100).toFixed(2);

const faqs = [
  {
    q: `How much does it cost to call ${d.name} with Kalum?`,
    a:
      card.basis === "from"
        ? `From ${rate} per minute to any ${d.demonym} number, as of ${asOf}. Mobile and landline numbers there can price differently, so the app shows the exact rate for the number you type before you dial — that is the rate you are charged. Calls are billed per minute, rounded up, with a one-minute minimum.`
        : `${rate} per minute to any ${d.demonym} number, as of ${asOf}. Calls are billed per minute, rounded up, with a one-minute minimum, and you always see the current rate in the app before you dial.`,
  },
  {
    q: `Does the person in ${d.name} need the app or internet?`,
    a: `No. Kalum routes through real phone networks, so their phone rings like any normal call. They need no app, no smartphone, and no internet — an old landline or feature phone works.`,
  },
  {
    q: `Can I call landlines in ${d.name}?`,
    a:
      card.basis === "from"
        ? `Yes. Kalum reaches landlines and mobiles in ${d.name} alike, and whoever you call answers on whatever phone they already have. Per-minute rates can differ between the two, so the app shows the exact rate for the number you type before the call starts.`
        : `Yes. Landlines and mobiles in ${d.name} cost the same ${rate} per minute. Whoever you call answers on whatever phone they already have.`,
  },
  {
    q: `How do I call ${d.name}?`,
    a: `Download Kalum on iPhone or Android, sign up with your phone number, and add credit starting from $4.99. Pick ${d.name} (+${d.dialCode}) in the dialer, type the local number, and hit call.`,
  },
  {
    q: `Can I call ${d.name} from my cell phone?`,
    a: `Yes. Kalum runs on your own iPhone or Android, so you call ${d.name} straight from your cell phone over Wi-Fi or mobile data. The person you reach picks up on whatever phone they already have — no app or internet needed on their end.`,
  },
  {
    q: `What is the number format for calling ${d.name}?`,
    a: `${d.dialingNote} In the Kalum dialer you just pick ${d.name} (+${d.dialCode}) and type the local number — the country code is set for you.`,
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://kalum.app/" },
        { "@type": "ListItem", position: 2, name: "Destinations", item: "https://kalum.app/call/" },
        { "@type": "ListItem", position: 3, name: `Call ${d.name}`, item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
    // Semantic hygiene for answer engines, not a rich result: Google restricted
    // FAQ rich results to gov/health domains in 2023, and price snippets are a
    // Product/shopping feature, not something a per-minute service rate earns.
    // This just states the price machine-readably, in the same terms the page
    // does. Kept a Service with its own @id so it can never be conflated with
    // the site-wide MobileApplication offer in BaseLayout, which is the app's
    // own price (free) and not a call rate. Under prefix pricing the figure is
    // a floor, so it goes in minPrice — never `price`, which would assert a
    // single fixed rate.
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: `International calls to ${nameAtSentenceStart(d)}`,
      serviceType: "International calling",
      provider: { "@id": "https://kalum.app/#organization" },
      areaServed: { "@type": "Country", name: nameAtSentenceStart(d) },
      offers: {
        "@type": "Offer",
        priceCurrency: "USD",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          priceCurrency: "USD",
          ...(card.basis === "from"
            ? { minPrice: priceUsd }
            : { price: priceUsd }),
          referenceQuantity: {
            "@type": "QuantitativeValue",
            value: 1,
            unitCode: "MIN",
          },
          validFrom: card.fetchedAt,
        },
      },
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  alternates={alternatesFor(`/call/${d.slug}/`)}
>
  <!-- Hero -->
  <section class="brand-gradient relative overflow-hidden text-white">
    <div class="absolute inset-0 opacity-[0.07]" aria-hidden="true">
      <div class="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-white blur-3xl"></div>
      <div class="absolute bottom-0 right-0 h-96 w-96 rounded-full bg-[var(--color-teal)] blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-4xl px-5 py-20 md:px-8 md:py-28">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-white/70">
        <ol class="flex flex-wrap items-center gap-x-2">
          <li><a href="/" class="hover:text-white transition">Home</a></li>
          <li aria-hidden="true" class="text-white/40">/</li>
          <li><a href="/call/" class="hover:text-white transition">Destinations</a></li>
          <li aria-hidden="true" class="text-white/40">/</li>
          <li aria-current="page" class="text-white/90">Call {d.name}</li>
        </ol>
      </nav>
      <p class="eyebrow text-[var(--color-teal-light)]">
        Calling {d.name} &middot; +{d.dialCode}
      </p>
      <h1 class="mt-5 text-4xl font-extrabold leading-[1.05] tracking-display sm:text-5xl lg:text-6xl">
        {headline}
        <span class="block text-white/85">{subhead}</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85 sm:text-xl">
        {d.intro}
      </p>

      {
        /* The price left the headline, so it gets its own line rather than
           living only in the FAQ — this page still has to answer "what does
           it cost" above the fold. */
        !priceLed && (
          <p class="mt-6 text-lg font-semibold text-white sm:text-xl">{heroRateLine}</p>
        )
      }

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <AppStoreBadge size="lg" utm={`kalum-web-call-${d.slug}`} />
        <GooglePlayBadge size="lg" utm={`kalum-web-call-${d.slug}`} />
      </div>

      <RateDisclosure card={card} tone="dark" class="mt-5 max-w-2xl" />

      {
        d.voipRestricted && (
          <p class="mt-5 max-w-2xl text-sm text-white/80">
            Voice calls on many internet apps are restricted in {d.name}.
            <a
              href="/whatsapp-calls-blocked/"
              class="ml-1 font-semibold text-[var(--color-teal-light)] underline underline-offset-2 transition hover:text-white"
            >
              More on calling when internet calls are blocked &rarr;
            </a>
          </p>
        )
      }
    </div>
  </section>

  <!--
    Number format.

    This used to be an h3 in the card stack below, roughly 29% down the page,
    and it was the only thing on the page answering questions we already rank
    for: "turkey mobile number digits" (position 1), "010 egypt number" (8.8),
    "jordan phone number format" (11), "oman mobile number digits" (16). All of
    them earned zero clicks, because nothing above the fold — and nothing in
    the snippet — said we had the answer.

    So it leads now, before the product pitch: someone who looked up the format
    wants the format, and the three steps for buying credit are what they read
    after they have it. Same words as before, promoted to an h2 and given the
    dial code as a display element.
  -->
  <section class="bg-[var(--color-cream)] py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-5 md:px-8">
      <div class="rounded-2xl border border-black/5 bg-white p-8 shadow-sm md:p-10">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
          <h2 class="text-2xl font-extrabold tracking-display text-[var(--color-text)] sm:text-3xl">
            The {d.demonym} number format
          </h2>
          <span
            class="rounded-full bg-[var(--color-cream)] px-3 py-1 font-mono text-sm font-bold text-[var(--color-maroon)]"
            >+{d.dialCode}</span
          >
        </div>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-muted)]">
          {d.dialingNote}
        </p>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-[var(--color-muted)]">
          In the Kalum dialer you just pick {d.name} (+{d.dialCode}) and type the
          local number — the country code is set for you.
        </p>
      </div>
    </div>
  </section>

  {
    (corridorsOut.length > 0 || corridorsIn.length > 0) && (
      <section class="bg-white pt-16 md:pt-20">
        <div class="mx-auto max-w-4xl px-5 md:px-8">
          <h2 class="text-2xl font-extrabold tracking-display text-[var(--color-text)] sm:text-3xl">
            {corridorsOut.length > 0
              ? `In ${d.name} and your app calls won't connect?`
              : `Calling ${d.name} from a country that restricts app calls?`}
          </h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2">
            {[...corridorsOut, ...corridorsIn].map((c) => (
              <li>
                <a
                  href={c.path}
                  class="block h-full rounded-2xl border border-black/5 bg-[var(--color-cream)] p-6 transition hover:border-[var(--color-maroon)]/40 hover:shadow-md"
                >
                  <span class="block text-lg font-bold text-[var(--color-text)]">
                    {c.label} &rarr;
                  </span>
                  <span class="mt-2 block text-base leading-relaxed text-[var(--color-muted)]">
                    {c.blurb}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- How to call -->
  <section class="bg-white py-20 md:py-28">
    <div class="mx-auto max-w-4xl px-5 md:px-8">
      <h2 class="text-3xl font-extrabold tracking-display text-[var(--color-text)] sm:text-4xl">
        How to call {d.name}
      </h2>

      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        <li class="rounded-2xl border border-black/5 bg-[var(--color-cream)] p-8">
          <span aria-hidden="true" class="text-6xl font-extrabold leading-none text-[var(--color-teal-ink)]">1</span>
          <h3 class="mt-4 text-xl font-bold text-[var(--color-text)]">Get Kalum</h3>
          <p class="mt-2 text-base leading-relaxed text-[var(--color-muted)]">
            Download the app on iPhone or Android and sign up with your phone
            number. One verification code — no email, no password.
          </p>
        </li>
        <li class="rounded-2xl border border-black/5 bg-[var(--color-cream)] p-8">
          <span aria-hidden="true" class="text-6xl font-extrabold leading-none text-[var(--color-teal-ink)]">2</span>
          <h3 class="mt-4 text-xl font-bold text-[var(--color-text)]">Add credit</h3>
          <p class="mt-2 text-base leading-relaxed text-[var(--color-muted)]">
            Start with $4.99 and top up whenever you want. No subscription, no
            contract — your credit never expires.
          </p>
        </li>
        <li class="rounded-2xl border border-black/5 bg-[var(--color-cream)] p-8">
          <span aria-hidden="true" class="text-6xl font-extrabold leading-none text-[var(--color-teal-ink)]">3</span>
          <h3 class="mt-4 text-xl font-bold text-[var(--color-text)]">Dial +{d.dialCode}</h3>
          <p class="mt-2 text-base leading-relaxed text-[var(--color-muted)]">
            Pick {d.name} (+{d.dialCode}) in the dialer, type the local number,
            and hit call. Their phone rings like any normal call.
          </p>
        </li>
      </ol>

      <div class="mt-12 text-center">
        <a
          href="/how-it-works/"
          class="inline-flex items-center gap-2 text-base font-semibold text-[var(--color-maroon)] hover:text-[var(--color-maroon-light)] transition"
        >
          See the full how-it-works
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-[var(--color-cream)] py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-5 md:px-8">
      <h2 class="text-3xl font-extrabold tracking-display text-[var(--color-text)] sm:text-4xl">
        Calling {d.name}, answered.
      </h2>

      <ul class="mt-10 divide-y divide-black/10 border-y border-black/10">
        {
          faqs.map((faq) => (
            <li>
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-semibold text-[var(--color-text)]">
                  <span>{faq.q}</span>
                  <span
                    aria-hidden="true"
                    class="mt-1 shrink-0 text-2xl font-light text-[var(--color-maroon)] transition-transform group-open:rotate-45"
                  >
                    +
                  </span>
                </summary>
                <p class="mt-3 pr-10 text-base leading-relaxed text-[var(--color-muted)]">
                  {faq.a}
                </p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Other destinations -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-5 md:px-8">
      <h2 class="text-2xl font-extrabold tracking-display text-[var(--color-text)] sm:text-3xl">
        More destinations
      </h2>
      <p class="mt-3 text-base text-[var(--color-muted)]">
        Kalum calls landlines and mobiles in {countries}+ countries. A few more:
      </p>
      <ul class="mt-6 flex flex-wrap gap-3">
        {
          others.map((o) => (
            <li>
              <a
                href={`/call/${o.slug}/`}
                class="inline-block rounded-full border border-black/10 bg-[var(--color-cream)] px-4 py-2 text-sm font-semibold text-[var(--color-text)] hover:border-[var(--color-maroon)] hover:text-[var(--color-maroon)] transition"
              >
                {o.name} &middot; {from}{formatRate(o.rateCents)}/min
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="brand-gradient text-white">
    <div class="mx-auto max-w-3xl px-5 py-16 text-center md:px-8 md:py-20">
      <h2 class="text-3xl font-extrabold tracking-display sm:text-4xl">
        Ready to call {d.name}?
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-white/85">
        Download Kalum, add $4.99 in credit, and dial. Pay only for the
        minutes you use.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <AppStoreBadge size="lg" utm={`kalum-web-call-${d.slug}`} />
        <GooglePlayBadge size="lg" utm={`kalum-web-call-${d.slug}`} />
      </div>
      <RateDisclosure card={card} tone="dark" class="mx-auto mt-5 max-w-xl" />
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>
