---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppStoreBadge from "../../components/AppStoreBadge.astro";
import GooglePlayBadge from "../../components/GooglePlayBadge.astro";
import RateDisclosure from "../../components/RateDisclosure.astro";
import RateFinder from "../../components/RateFinder.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { pricedDestinations, formatRate, fromPrefix } from "../../lib/rates";
import { alternatesFor } from "../../lib/i18n";
import { coverage } from "../../lib/rates";

const countries = await coverage();

// The rates hub. Rates come from the live rate card at build time and are
// baked into this HTML — see src/lib/rates.ts.
const { card, priced } = await pricedDestinations();
const from = fromPrefix(card.basis);

// Kept for the hero copy, not for the title. The title used to lead with this
// figure and it was a bid on a SERP this site loses: over the three months to
// 2026-08-30 the hub took 33 rate-comparison queries — "international calling
// rates", "cheap calls to iraq", "cheapest local call rates sudan" — for 95
// impressions, zero clicks, at an average position of 43. Rivals' retail beats
// our cost on those corridors, so leading with a number hands the reader the
// comparison before the click. The dial-code framing below targets the intent
// the destination pages actually rank for instead.
const minRate = Math.min(...priced.map((d) => d.rateCents));

// Group destinations by region for a scannable index. Fixed display order;
// empty regions are dropped so adding/removing destinations just works. This
// is a grouping order, not a ranking — Kalum is a general international
// calling provider, so the hub leads with no favored region.
const regionOrder = ["Americas", "Middle East", "Asia", "Africa"] as const;
const grouped = regionOrder
  .map((region) => ({
    region,
    items: priced.filter((d) => d.region === region),
  }))
  .filter((g) => g.items.length > 0);
---

<BaseLayout
  title={`Country Codes & Calling Rates — ${priced.length} Destinations | Kalum`}
  description={`Dialing codes, number formats and per-minute rates for ${priced.length} destinations — Mexico, India, Egypt, Nigeria and more. No app or internet on their end.`}
  canonical="https://kalum.app/call/"
  alternates={alternatesFor("/call/")}
>
  <section class="bg-[var(--color-cream)] py-16 md:py-24">
    <div class="mx-auto max-w-4xl px-5 md:px-8">
      <Breadcrumb tone="light" items={[{ name: "Home", href: "/" }, { name: "Destinations" }]} />
      <p class="eyebrow text-[var(--color-maroon)]">
        Destinations
      </p>
      <h1 class="mt-4 text-4xl font-extrabold leading-[1.05] tracking-display text-[var(--color-text)] sm:text-5xl">
        Country codes and calling rates, by destination.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[var(--color-muted)]">
        Per-minute rates to landlines and mobiles, and the person you call
        never needs an app or internet. Here are some of the most-called
        destinations, grouped by region; the app shows live rates for {countries}+
        countries before you dial.
      </p>

      <RateFinder card={card} class="mt-10" />

      <div class="mt-12 space-y-12">
        {
          grouped.map((group) => (
            <div>
              <h2 class="text-2xl font-extrabold tracking-display text-[var(--color-text)] sm:text-3xl">
                {group.region}
              </h2>
              <ul class="mt-5 grid gap-4 sm:grid-cols-2">
                {group.items.map((d) => (
                  <li>
                    <a
                      href={`/call/${d.slug}/`}
                      class="flex items-center justify-between gap-4 rounded-2xl border border-black/5 bg-white p-6 shadow-sm transition hover:border-[var(--color-maroon)]/40 hover:shadow-md"
                    >
                      <span>
                        <span class="block text-lg font-bold text-[var(--color-text)]">
                          Call {d.name}
                        </span>
                        <span class="mt-1 block text-sm text-[var(--color-muted)]">
                          +{d.dialCode} &middot; landlines &amp; mobiles
                        </span>
                      </span>
                      <span class="shrink-0 text-right">
                        {from && (
                          <span class="micro-label block text-[var(--color-muted)]">
                            from
                          </span>
                        )}
                        <span class="text-2xl font-extrabold tabular-nums text-[var(--color-maroon)]">
                          {formatRate(d.rateCents)}<span class="text-sm font-semibold text-[var(--color-muted)]">/min</span>
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      {/*
        The three corridor pages had 4-5 inbound links each at the 2026-09-19
        audit, under the ~7 that src/lib/corridors.ts records as the crawl
        cutoff — and this hub, which every destination page links to, said
        nothing about them. They are also genuinely the next thing a reader
        here wants: the hub answers "what does it cost to call X", these
        answer "how do I call X from where I am".
      */}
      <div class="mt-12 rounded-2xl border border-black/5 bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-xl font-extrabold tracking-display text-[var(--color-text)]">
          Calling from the UAE
        </h2>
        <p class="mt-3 text-lg leading-relaxed text-[var(--color-muted)]">
          Voice calls on many internet apps are restricted there, so a call
          that dials the real number behaves differently from one that does
          not. These pages cover the dialling itself:
          <a class="font-semibold text-[var(--color-maroon)] underline decoration-[var(--color-maroon)]/30 underline-offset-4 hover:decoration-[var(--color-maroon)]" href="/call-from-uae/">calling abroad from the UAE</a>,
          <a class="font-semibold text-[var(--color-maroon)] underline decoration-[var(--color-maroon)]/30 underline-offset-4 hover:decoration-[var(--color-maroon)]" href="/call-india-from-uae/">calling India from the UAE</a>, and
          <a class="font-semibold text-[var(--color-maroon)] underline decoration-[var(--color-maroon)]/30 underline-offset-4 hover:decoration-[var(--color-maroon)]" href="/call-pakistan-from-uae/">calling Pakistan from the UAE</a>.
        </p>
      </div>

      <RateDisclosure card={card} class="mt-8" />
    </div>
  </section>

  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-5 md:px-8">
      <h2 class="text-3xl font-extrabold tracking-display text-[var(--color-text)] sm:text-4xl">
        How international calling rates work
      </h2>
      <div class="mt-6 space-y-5 text-lg leading-relaxed text-[var(--color-muted)]">
        <p>
          Phone networks in every country charge their own price to connect an
          incoming call, which is why international calling rates differ by
          destination — a minute to Mexico doesn't cost the same as a minute
          to Lebanon. Rates can also change over time as networks adjust what
          they charge.
        </p>
        <p>
          Rates can also differ within a country: a mobile and a landline sit
          on different networks, which is why the figures above are a starting
          price per destination rather than one price for every number there.
          That's why Kalum shows you the live per-minute rate for the exact
          number you're dialing, before the call starts. Calls are billed by
          the minute, rounded up, with a one-minute minimum — no connection
          fees and no hidden charges.
        </p>
        <p>
          There's no subscription either: you add prepaid credit starting from
          $4.99, it never expires, and you pay only for the minutes you use.
          <a
            href="/how-it-works/"
            class="font-semibold text-[var(--color-maroon)] hover:text-[var(--color-maroon-light)] transition"
          >See how Kalum works &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <section class="brand-gradient text-white">
    <div class="mx-auto max-w-3xl px-5 py-16 text-center md:px-8 md:py-20">
      <h2 class="text-3xl font-extrabold tracking-display sm:text-4xl">
        Don't see your country?
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-white/85">
        Kalum reaches landlines and mobiles in {countries}+ countries. Download the
        app and check the live rate for any destination — free to look, no
        subscription.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <AppStoreBadge size="lg" utm="kalum-web-destinations" />
        <GooglePlayBadge size="lg" utm="kalum-web-destinations" />
      </div>
    </div>
  </section>
</BaseLayout>
