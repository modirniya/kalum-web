---
import { playHref } from "../lib/stores";

interface Props {
  size?: "lg" | "md" | "sm";
  utm?: string;
  /** Tag this link as a conversion CTA (adds data-aw-cta for gtag tracking). */
  cta?: boolean;
  /** "eager" above the fold (hero); "lazy" below (footer). */
  loading?: "eager" | "lazy";
}

const { size = "lg", utm = "kalum-web", cta = false, loading = "eager" } = Astro.props;

// Sized by height to match AppStoreBadge: lg 56px, md 48px, sm 44px. The
// asset is the trimmed 564x168 PNG (aspect 3.357) with the official 41px
// transparent padding removed, so it pairs with Apple's edge-to-edge SVG at
// the same height.
const sizeClass = size === "lg" ? "h-14" : size === "md" ? "h-12" : "h-11";

const href = playHref(utm);
---

<a
  href={href}
  rel="noopener"
  aria-label="Download Kalum on Google Play"
  class="inline-block rounded-[10px] transition hover:-translate-y-px"
  data-aw-cta={cta ? "" : undefined}
>
  <img
    src="/badges/google-play.png"
    alt="Get it on Google Play"
    width="564"
    height="168"
    class={`w-auto ${sizeClass}`}
    loading={loading}
    decoding="async"
  />
</a>
