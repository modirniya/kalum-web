---
interface Props {
  size?: "lg" | "md" | "sm";
  utm?: string;
}

const { size = "lg", utm = "kalum-web" } = Astro.props;

// Sized to match AppStoreBadge heights. Google Play asset is the trimmed
// 564x168 PNG (aspect 3.357) with the official 41px transparent padding
// removed — paired with Apple's edge-to-edge SVG at the same heights this
// keeps the two badges visually balanced. Widths chosen so the rendered
// height matches AppStoreBadge at each size: lg 87px, md 74px, sm 62px.
const widthClass =
  size === "lg" ? "w-[292px]" : size === "md" ? "w-[248px]" : "w-[208px]";

const href = `https://play.google.com/store/apps/details?id=app.kalum.mobile&utm_source=${utm}`;
---

<a
  href={href}
  rel="noopener"
  aria-label="Download Kalum on Google Play"
  class="inline-block transition hover:scale-[1.02]"
>
  <img
    src="/badges/google-play.png"
    alt="Get it on Google Play"
    width="564"
    height="168"
    class={`h-auto ${widthClass}`}
    loading="eager"
    decoding="async"
  />
</a>
