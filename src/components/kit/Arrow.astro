---
/** Forward arrow (lucide arrow-right), flipped under dir="rtl". */
interface Props {
  class?: string;
}
const { class: cls = "size-4" } = Astro.props;
---

<svg
  class:list={["flip-rtl inline-block shrink-0", cls]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
>
