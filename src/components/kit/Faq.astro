---
/**
 * Questions and answers as one white card of <details> rows (MASTER.md §6).
 * Answers are plain text unless `html` is set (for copy that carries links).
 *
 * Structured data stays with the page, built from the same array it passes
 * here, so markup and FAQPage JSON-LD cannot disagree.
 */
interface Item {
  q: string;
  a: string;
}
interface Props {
  items: Item[];
  html?: boolean;
  class?: string;
}
const { items, html = false, class: cls = "" } = Astro.props;
---

<ul class:list={["card divide-y divide-[var(--color-outline)] overflow-hidden", cls]}>
  {
    items.map((item) => (
      <li>
        <details class="group">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 px-5 py-4 text-base font-semibold transition-colors hover:bg-[var(--color-surface-2)] md:px-6 [&::-webkit-details-marker]:hidden">
            <span>{item.q}</span>
            <svg
              class="size-5 shrink-0 text-[var(--color-ink-2)] transition-transform duration-200 group-open:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          {html ? (
            <p class="px-5 pb-5 leading-relaxed text-[var(--color-ink-2)] md:px-6 [&_a]:link" set:html={item.a} />
          ) : (
            <p class="px-5 pb-5 leading-relaxed text-[var(--color-ink-2)] md:px-6">{item.a}</p>
          )}
        </details>
      </li>
    ))
  }
</ul>
