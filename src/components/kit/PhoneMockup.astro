---
import { Image } from "astro:assets";
import heroScreen from "../../assets/screenshots/home.png";

/**
 * The app's dial screen in a phone frame, for showcase heroes. Placed in a
 * PageHero card slot it hangs over the wave, so the app's own wave header and
 * the page's meet.
 */
interface Props {
  alt: string;
  class?: string;
}
const { alt, class: cls = "" } = Astro.props;
---

<div class:list={["mx-auto w-fit lg:me-0", cls]}>
  <div class="rounded-[2.6rem] bg-[#111] p-2.5 shadow-[0_24px_48px_-12px_rgb(0_0_0/0.45)] ring-1 ring-white/10">
    <Image
      src={heroScreen}
      alt={alt}
      widths={[260, 300, 600]}
      sizes="(min-width: 640px) 300px, 260px"
      class="h-auto w-[260px] rounded-[2rem] sm:w-[300px]"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</div>
