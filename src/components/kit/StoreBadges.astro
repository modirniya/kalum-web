---
import AppStoreBadge from "../AppStoreBadge.astro";
import GooglePlayBadge from "../GooglePlayBadge.astro";

/**
 * The two official store badges, side by side. They are the main CTA on every
 * page (MASTER.md §6). `cta-zone` marks them for the mobile sticky pill, which
 * stays hidden while any zone is on screen so it never covers a badge.
 */
interface Props {
  utm: string;
  size?: "lg" | "md" | "sm";
  align?: "start" | "center";
  loading?: "eager" | "lazy";
  cta?: boolean;
  class?: string;
}
const {
  utm,
  size = "lg",
  align = "start",
  loading = "eager",
  cta = false,
  class: cls = "",
} = Astro.props;
---

<div
  data-cta-zone
  class:list={[
    "flex flex-wrap items-center gap-3",
    align === "center" && "justify-center",
    cls,
  ]}
>
  <AppStoreBadge size={size} utm={utm} loading={loading} cta={cta} />
  <GooglePlayBadge size={size} utm={utm} loading={loading} cta={cta} />
</div>
