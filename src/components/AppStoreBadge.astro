---
import { appleHref } from "../lib/stores";

interface Props {
  size?: "lg" | "md" | "sm";
  utm?: string;
  /** Tag this link as a conversion CTA (adds data-aw-cta for gtag tracking). */
  cta?: boolean;
  /** "eager" above the fold (hero); "lazy" below (footer). */
  loading?: "eager" | "lazy";
}

const { size = "lg", utm = "kalum-web", cta = false, loading = "eager" } = Astro.props;

// Sized by height so the pair always lines up with GooglePlayBadge: lg 56px
// (hero), md 48px, sm 44px (footer, still a full tap target). Both assets are
// trimmed edge to edge, so equal heights look equal. They were 87/74/62px,
// which stacked into a wall of badges on a phone.
const sizeClass = size === "lg" ? "h-14" : size === "md" ? "h-12" : "h-11";

const href = appleHref(utm);
---

<a
  href={href}
  rel="noopener"
  aria-label="Download Kalum on the App Store"
  class="inline-block rounded-[10px] transition hover:-translate-y-px"
  data-aw-cta={cta ? "" : undefined}
>
  <img
    src="/badges/app-store.svg"
    alt="Download on the App Store"
    width="119.66"
    height="40"
    class={`w-auto ${sizeClass}`}
    loading={loading}
    decoding="async"
  />
</a>
