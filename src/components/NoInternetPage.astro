---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "./Breadcrumb.astro";
import LanguageBar from "./LanguageBar.astro";
import PageHero from "./kit/PageHero.astro";
import HeroCopy from "./kit/HeroCopy.astro";
import StoreBadges from "./kit/StoreBadges.astro";
import Section from "./kit/Section.astro";
import Faq from "./kit/Faq.astro";
import CtaBand from "./kit/CtaBand.astro";
import LinkChips from "./kit/LinkChips.astro";
import Arrow from "./kit/Arrow.astro";
import { alternatesFor, LOCALES, type Locale } from "../lib/i18n";
import { NO_INTERNET_COPY } from "../lib/no-internet-copy";
import {
  coverage,
  pricedDestinations,
  formatRate,
  fromPrefix,
} from "../lib/rates";

/**
 * Shared body for every non-English /call-without-internet/ page.
 *
 * Structure mirrors the English page section for section — hero, "you need
 * internet, they don't", who it's for, links to destination pages, FAQ, CTA —
 * so every one of these stays the same page in a different language rather
 * than a different product. Prose comes from src/lib/no-internet-copy.ts, the
 * destination count from the live rate card, exactly as the originals.
 *
 * A locale with a tree of its own links its own pages: `homeHref` retargets
 * the breadcrumb, `destinationsHreflang` labels the rate links, and a
 * destination carrying a `slug` shows its live per-minute rate. A single-page
 * locale sets none of those and links the English rate pages.
 *
 * Direction and font come from LOCALES; the layout uses logical properties
 * (ms-/me-/ps-/pe-/text-start) so the same markup flips correctly for Arabic
 * and Urdu with no per-direction branches.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy = NO_INTERNET_COPY[locale];
if (!copy) {
  throw new Error(`NoInternetPage: no copy for locale "${locale}" in no-internet-copy.ts`);
}
const meta = LOCALES[locale];
const countries = await coverage();

const path = `/${locale}/call-without-internet/`;
const canonical = `https://kalum.app${path}`;
const faqs = copy.faqs(countries);

// Live per-minute rates for any destination link that asked for one. Skipped
// entirely when none did, so the single-page locales do no rate work.
const wantsRates = copy.destinations.some((d) => d.slug);
const { card, priced } = wantsRates
  ? await pricedDestinations()
  : { card: null, priced: [] };
const from = card ? fromPrefix(card.basis, locale === "es" ? "es" : "en") : "";
const destinations = copy.destinations.map((d) => {
  const rate = d.slug ? priced.find((p) => p.slug === d.slug) : undefined;
  return { ...d, rate: rate ? `${from}${formatRate(rate.rateCents)}/min` : null };
});

const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};

// Label before the language list, in this page's language. Kept in the copy
// table's spirit — short, and not a claim.
const alsoIn: Record<Locale, string> = {
  en: "Also in:",
  es: "También en:",
  ar: "بلغات أخرى:",
  tr: "Diğer diller:",
  hi: "अन्य भाषाएँ:",
  ur: "دیگر زبانیں:",
  bn: "অন্য ভাষায়:",
  tl: "Sa ibang wika:",
  vi: "Ngôn ngữ khác:",
  id: "Bahasa lain:",
  pt: "Outros idiomas:",
};
---

<BaseLayout
  title={copy.title}
  description={copy.description(countries)}
  canonical={canonical}
  lang={locale}
  dir={meta.dir}
  alternates={alternatesFor(path)}
>
  <PageHero>
    <Breadcrumb
      items={[
        { name: copy.crumbHome, href: copy.homeHref ?? "/" },
        { name: copy.crumbSelf },
      ]}
    />
    <HeroCopy eyebrow={copy.eyebrow} title={copy.h1[0]} accent={copy.h1[1]} lead={copy.intro(countries)} />
    <StoreBadges utm={copy.utm} class="mt-8" />
    <p class="mt-4 text-sm text-white/70">{copy.finePrint}</p>
    <LanguageBar path={path} label={alsoIn[locale]} tone="light" class="mt-6" />
  </PageHero>

  <Section section="explainer" width="narrow" title={copy.explainerH2}>
    <div class="text-lead space-y-5 text-[var(--color-ink-2)]">
      {copy.explainer.map((p) => <p>{p}</p>)}
    </div>
  </Section>

  <Section section="reasons" title={copy.reasonsH2} align="center">
    <div class="grid gap-4 md:grid-cols-3">
      {
        copy.reasons.map((reason) => (
          <div class="card p-6 md:p-7">
            <h3 class="text-heading">{reason.title}</h3>
            <p class="mt-2 leading-relaxed text-[var(--color-ink-2)]">{reason.body}</p>
          </div>
        ))
      }
    </div>
    {
      copy.reasonsMore && (
        <p class="mt-8 text-center">
          <a href={copy.reasonsMore.href} class="link inline-flex items-center gap-1.5">
            {copy.reasonsMore.label} <Arrow />
          </a>
        </p>
      )
    }
  </Section>

  <!-- Destination links. English rate pages unless the locale has its own. -->
  <Section
    section="destinations"
    width="mid"
    title={copy.destinationsH2}
    lead={copy.destinationsIntro?.(countries)}
  >
    <LinkChips
      items={destinations.map((d) => ({
        label: d.rate ? `${d.label} · ${d.rate}` : d.label,
        href: d.href,
        hreflang: copy.destinationsHreflang ?? "en",
      }))}
    />
    {
      copy.destinationsNote && (
        <p class="mt-4 text-sm text-[var(--color-ink-2)]">{copy.destinationsNote}</p>
      )
    }
    {
      copy.destinationsMore && (
        <p class="mt-6">
          <a href={copy.destinationsMore.href} class="link inline-flex items-center gap-1.5">
            {copy.destinationsMore.label} <Arrow />
          </a>
        </p>
      )
    }
  </Section>

  <Section section="faq" width="narrow" title={copy.faqH2}>
    <Faq items={faqs} />
  </Section>

  <CtaBand title={copy.ctaH2} body={copy.ctaBody(countries)} utm={copy.utm} />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>
