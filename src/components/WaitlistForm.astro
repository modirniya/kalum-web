---
// Phase 1: Buttondown embed for pre-launch waitlist.
// TODO: Replace BUTTONDOWN_HANDLE_TODO with the real Buttondown handle once
// the account is created. Phase 2 will swap action= for the Cloudflare Worker
// endpoint; the form markup below should remain unchanged.
interface Props {
  variant?: "light" | "dark";
}

const { variant = "dark" } = Astro.props;

const inputClass =
  variant === "dark"
    ? "w-full rounded-md bg-white/95 px-4 py-3 text-base text-[var(--color-text)] placeholder:text-[var(--color-muted)] outline-none focus:ring-2 focus:ring-[var(--color-teal)]"
    : "w-full rounded-md border border-black/10 bg-white px-4 py-3 text-base text-[var(--color-text)] placeholder:text-[var(--color-muted)] outline-none focus:ring-2 focus:ring-[var(--color-maroon)]";

const buttonClass =
  variant === "dark"
    ? "rounded-md bg-[var(--color-teal)] px-5 py-3 text-base font-semibold text-[var(--color-navy)] hover:bg-[var(--color-teal-light)] transition shadow-lg shadow-black/20"
    : "rounded-md bg-[var(--color-maroon)] px-5 py-3 text-base font-semibold text-white hover:bg-[var(--color-maroon-light)] transition";

const microClass = variant === "dark" ? "text-white/70" : "text-[var(--color-muted)]";
---

<form
  action="https://buttondown.com/api/emails/embed-subscribe/BUTTONDOWN_HANDLE_TODO"
  method="post"
  target="popupwindow"
  onsubmit="window.open('https://buttondown.com/BUTTONDOWN_HANDLE_TODO', 'popupwindow')"
  class="flex flex-col gap-3 sm:flex-row"
>
  <label for="bd-email" class="sr-only">Email address</label>
  <input
    id="bd-email"
    type="email"
    name="email"
    placeholder="you@example.com"
    autocomplete="email"
    required
    class={`flex-1 ${inputClass}`}
  />
  <button type="submit" class={buttonClass}>
    Notify me when it launches
  </button>
</form>
<p class={`mt-3 text-xs ${microClass}`}>
  No spam. One email when the app goes live.
</p>
