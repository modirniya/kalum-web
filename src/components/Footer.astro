---
import { Image } from "astro:assets";
import icon from "../assets/kalum-icon.jpg";
import GooglePlayBadge from "./GooglePlayBadge.astro";
import AppStoreBadge from "./AppStoreBadge.astro";
import { featuredDestinations } from "../lib/destinations";
import { coverage } from "../lib/rates";

const countries = await coverage();

const year = new Date().getFullYear();
const popular = featuredDestinations();

const path = Astro.url.pathname;
const isES = path === "/es/" || path.startsWith("/es/");

const t = isES
  ? {
      blurb:
        `Llamadas económicas a teléfonos fijos y celulares en más de ${countries} países. Solo contestan su teléfono.`,
      product: "Producto",
      legal: "Legal",
      getApp: "Descargar la app",
      productLinks: [
        { href: "/es/call/mexico/", label: "Llamar a México" },
        { href: "/es/call-without-internet/", label: "Llamar sin internet" },
      ],
      legalLinks: [
        { href: "/privacy/", label: "Privacidad" },
        { href: "/terms/", label: "Términos" },
      ],
      madeBy: "Kalum es un producto de Neuera",
    }
  : {
      blurb:
        `Cheap calls to landlines and mobiles in ${countries}+ countries. They just pick up the phone.`,
      product: "Product",
      legal: "Legal",
      getApp: "Get the app",
      productLinks: [
        { href: "/how-it-works/", label: "How it works" },
        { href: "/call/", label: "Destinations" },
        { href: "/call-without-internet/", label: "Call without internet" },
        { href: "/calling-app-vs-internet-calling/", label: "App vs internet calling" },
        { href: "/whatsapp-calls-blocked/", label: "WhatsApp calls blocked?" },
        { href: "/support/", label: "Support" },
      ],
      legalLinks: [
        { href: "/privacy/", label: "Privacy policy" },
        { href: "/terms/", label: "Terms of service" },
      ],
      madeBy: "Kalum is a product of Neuera",
    };
---

<footer class="bg-[var(--color-navy)] text-white/80">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-4 md:px-8">
    <div class="md:col-span-1">
      <div class="flex items-center gap-3">
        <Image
          src={icon}
          alt="Kalum"
          width={36}
          height={36}
          densities={[1, 2, 3]}
          class="h-9 w-9 rounded-md bg-white p-0.5"
        />
        <span class="text-lg font-extrabold tracking-[0.18em] text-white">KALUM</span>
      </div>
      <p class="mt-4 max-w-xs text-sm leading-relaxed">{t.blurb}</p>
    </div>

    <div>
      <h4 class="micro-label text-white">{t.product}</h4>
      <ul class="mt-4 space-y-2 text-sm">
        {t.productLinks.map((l) => (
          <li><a href={l.href} class="hover:text-white">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="micro-label text-white">{t.legal}</h4>
      <ul class="mt-4 space-y-2 text-sm">
        {t.legalLinks.map((l) => (
          <li><a href={l.href} class="hover:text-white">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="micro-label text-white">{t.getApp}</h4>
      <div class="mt-4 flex flex-col gap-3">
        <AppStoreBadge size="md" utm="kalum-web-footer" loading="lazy" />
        <GooglePlayBadge size="md" utm="kalum-web-footer" loading="lazy" />
      </div>
    </div>
  </div>

  {
    !isES && (
      <div class="border-t border-white/10">
        <div class="mx-auto max-w-6xl px-5 py-6 md:px-8">
          <h4 class="micro-label text-white">
            Popular destinations
          </h4>
          <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
            {popular.map((d) => (
              <li>
                <a href={`/call/${d.slug}/`} class="hover:text-white">
                  Call {d.name}
                </a>
              </li>
            ))}
            <li>
              <a href="/call/" class="font-semibold text-white/90 hover:text-white">
                All destinations &rarr;
              </a>
            </li>
          </ul>
        </div>
      </div>
    )
  }

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-6 text-xs text-white/60 md:flex-row md:items-center md:justify-between md:px-8">
      <p>&copy; {year} Neuera &middot; {t.madeBy}</p>
      <p>
        <a href="mailto:hello@neuera.app" class="hover:text-white">hello@neuera.app</a>
        &middot; kalum.app
      </p>
    </div>
  </div>
</footer>
