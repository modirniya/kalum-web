---
import { Image } from "astro:assets";
import icon from "../assets/kalum-icon.jpg";

const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-navy)] text-white/80">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-4 md:px-8">
    <div class="md:col-span-1">
      <div class="flex items-center gap-3">
        <Image
          src={icon}
          alt=""
          width={36}
          height={36}
          class="h-9 w-9 rounded-md bg-white p-0.5"
        />
        <span class="text-lg font-extrabold tracking-[0.18em] text-white">KALUM</span>
      </div>
      <p class="mt-4 max-w-xs text-sm leading-relaxed">
        Cheap calls to the Middle East and 180+ countries.
        They just pick up the phone.
      </p>
    </div>

    <div>
      <h4 class="text-xs font-semibold uppercase tracking-widest text-white">Product</h4>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/how-it-works" class="hover:text-white">How it works</a></li>
        <li><a href="/support" class="hover:text-white">Support</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-xs font-semibold uppercase tracking-widest text-white">Legal</h4>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          {/* TODO: link to /privacy when Phase 4 ships */}
          <span class="text-white/40">Privacy policy</span>
        </li>
        <li>
          {/* TODO: link to /terms when Phase 4 ships */}
          <span class="text-white/40">Terms of service</span>
        </li>
      </ul>
    </div>

    <div>
      <h4 class="text-xs font-semibold uppercase tracking-widest text-white">Get the app</h4>
      <p class="mt-4 text-sm leading-relaxed">
        Coming soon to iPhone and Android.
      </p>
      <a
        href="/#waitlist"
        class="mt-3 inline-block rounded-md bg-[var(--color-teal)] px-4 py-2 text-sm font-semibold text-[var(--color-navy)] hover:bg-[var(--color-teal-light)] transition"
      >
        Join the waitlist
      </a>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-6 text-xs text-white/60 md:flex-row md:items-center md:justify-between md:px-8">
      <p>
        &copy; {year} Neuera &middot; Kalum is a product of Neuera
      </p>
      <p>
        <a href="mailto:hello@neuera.app" class="hover:text-white">hello@neuera.app</a>
        &middot; kalum.app
      </p>
    </div>
  </div>
</footer>
