---
const tiles = [
  {
    title: "Home landlines",
    body: "Perfect for parents and grandparents who never switched.",
    icon: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>`,
  },
  {
    title: "Old mobiles",
    body: "Any number. Any carrier. Any country.",
    icon: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2" width="10" height="20" rx="2"/><line x1="11" y1="18" x2="13" y2="18"/></svg>`,
  },
  {
    title: "No internet needed",
    body: "They don't download anything. They don't sign up. They just answer.",
    icon: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="2" y1="2" x2="22" y2="22"/><path d="M8.5 16.5a5 5 0 0 1 7 0"/><path d="M2 8.82a15 15 0 0 1 4.17-2.65"/><path d="M10.66 5c4.01-.36 8.14.9 11.34 3.76"/><path d="M16.85 11.25a10 10 0 0 1 2.22 1.68"/><path d="M5 13a10 10 0 0 1 5.24-2.76"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>`,
  },
];
---

<section class="bg-[var(--color-cream)] py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-[var(--color-text)] sm:text-4xl lg:text-5xl">
        Works with the phone they already have.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-[var(--color-muted)]">
        Kalum connects to real phone networks, not another app.
        Whoever you call answers on whatever phone they own.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        tiles.map((tile) => (
          <div class="rounded-2xl border border-black/5 bg-white p-8 shadow-sm">
            <div
              class="text-[var(--color-maroon)]"
              set:html={tile.icon}
            />
            <h3 class="mt-5 text-xl font-bold text-[var(--color-text)]">
              {tile.title}
            </h3>
            <p class="mt-2 text-base leading-relaxed text-[var(--color-muted)]">
              {tile.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
