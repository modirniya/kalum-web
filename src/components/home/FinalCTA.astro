---
import CtaBand from "../kit/CtaBand.astro";
import { coverage } from "../../lib/rates";
import { HOME_COPY, fill, type HomeLocale } from "../../lib/home-copy";

interface Props {
  locale?: HomeLocale;
}

const { locale = "en" } = Astro.props;
const c = HOME_COPY[locale].finalCta;
const utm = HOME_COPY[locale].utmPrefix;
const countries = await coverage();
---

<!-- Also the target of the header's download link (#download). -->
<CtaBand id="download" title={c.heading} body={fill(c.body, countries)} utm={`${utm}-final`} />
