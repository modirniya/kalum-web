---
import GooglePlayBadge from "../GooglePlayBadge.astro";
import WaitlistForm from "../WaitlistForm.astro";
---

<section class="brand-gradient relative overflow-hidden text-white">
  <div class="absolute inset-0 opacity-[0.06]" aria-hidden="true">
    <div class="absolute top-0 right-0 h-96 w-96 rounded-full bg-white blur-3xl"></div>
    <div class="absolute bottom-0 left-0 h-80 w-80 rounded-full bg-[var(--color-teal)] blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-3xl px-5 py-20 text-center md:px-8 md:py-28">
    <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl">
      Try Kalum for $2.99.
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-white/85">
      No commitment. Add more anytime. Cheap calls to Lebanon, Iraq,
      Jordan, Kuwait and 180+ countries &mdash; available now on Android.
    </p>

    <div class="mt-10 flex justify-center">
      <GooglePlayBadge size="lg" utm="kalum-web-final" />
    </div>

    <div
      id="ios-waitlist"
      class="mx-auto mt-16 max-w-lg rounded-2xl border border-white/10 bg-white/5 p-6 text-left backdrop-blur-sm"
    >
      <h3 class="text-xl font-bold">Launching soon on iPhone.</h3>
      <p class="mt-2 text-sm text-white/80">
        Drop your email and we'll send one message when Kalum is live on the App Store.
      </p>
      <div class="mt-5">
        <WaitlistForm variant="dark" />
      </div>
    </div>
  </div>
</section>
