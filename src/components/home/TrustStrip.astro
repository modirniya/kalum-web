---
import { coverage } from "../../lib/rates";

/**
 * The one-line trust bar under the hero. Locale-driven rather than
 * English-only: the Spanish home page had no trust strip at all until
 * 2026-09-19, because it was written by hand instead of from these
 * components. Adding a locale here is cheaper than a second component and
 * keeps the two homes from drifting again.
 */
interface Props {
  locale?: "en" | "es";
}
const { locale = "en" } = Astro.props;

const countries = await coverage();
const items =
  locale === "es"
    ? [
        `Más de ${countries} países`,
        "Sin suscripciones",
        "Sin contratos",
        "Tu saldo nunca vence",
        "Ves la tarifa antes de marcar",
      ]
    : [
        `${countries}+ countries`,
        "No subscriptions",
        "No contracts",
        "Credit never expires",
        "See the rate before you dial",
      ];
---

<!--
  The four plain facts, as a row of checked pills on the cream page rather
  than the old navy band: the app has no navy in light mode.
-->
<section data-section="trust" class="py-6 md:py-8">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <ul class="card flex flex-wrap items-center justify-center gap-x-6 gap-y-3 px-5 py-4 text-sm font-semibold md:gap-x-10">
      {
        items.map((item) => (
          <li class="flex items-center gap-2">
            <svg class="size-4 shrink-0 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>
