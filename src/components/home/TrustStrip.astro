---
import { coverage } from "../../lib/rates";

/**
 * The one-line trust bar under the hero. Locale-driven rather than
 * English-only: the Spanish home page had no trust strip at all until
 * 2026-09-19, because it was written by hand instead of from these
 * components. Adding a locale here is cheaper than a second component and
 * keeps the two homes from drifting again.
 */
interface Props {
  locale?: "en" | "es";
}
const { locale = "en" } = Astro.props;

const countries = await coverage();
const items =
  locale === "es"
    ? [
        `Más de ${countries} países`,
        "Sin suscripciones",
        "Sin contratos",
        "Tu saldo nunca vence",
        "Ves la tarifa antes de marcar",
      ]
    : [
        `${countries}+ countries`,
        "No subscriptions",
        "No contracts",
        "Credit never expires",
        "See the rate before you dial",
      ];
---

<section class="bg-[var(--color-navy)] text-white">
  <div class="mx-auto max-w-6xl px-5 py-7 md:px-8">
    <ul class="flex flex-wrap items-center justify-center gap-x-2 gap-y-2 text-center text-sm font-medium text-white/85 md:gap-x-3">
      {
        items.map((item, i) => (
          <>
            <li>{item}</li>
            {i < items.length - 1 && (
              <li aria-hidden="true" class="text-white/40">&middot;</li>
            )}
          </>
        ))
      }
    </ul>
  </div>
</section>
