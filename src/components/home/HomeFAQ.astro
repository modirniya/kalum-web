---
import { coverage } from "../../lib/rates";
import { HOME_COPY, fill, type HomeLocale } from "../../lib/home-copy";
import Section from "../kit/Section.astro";
import Faq from "../kit/Faq.astro";

interface Props {
  locale?: HomeLocale;
}

const { locale = "en" } = Astro.props;
const countries = await coverage();
const c = HOME_COPY[locale].faq;
const faqs = c.items.map((faq) => ({ q: faq.q, a: fill(faq.a, countries) }));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};
---

<Section section="faq" width="narrow" title={c.heading} lead={c.intro}>
  <Faq items={faqs} />
</Section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
