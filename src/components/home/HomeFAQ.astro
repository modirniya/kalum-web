---
import { coverage } from "../../lib/rates";
import { HOME_COPY, fill, type HomeLocale } from "../../lib/home-copy";

interface Props {
  locale?: HomeLocale;
}

const { locale = "en" } = Astro.props;
const countries = await coverage();
const c = HOME_COPY[locale].faq;
const faqs = c.items.map((faq) => ({ q: faq.q, a: fill(faq.a, countries) }));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};
---

<section data-section="faq" class="bg-[var(--color-cream)] py-20 md:py-28">
  <div class="mx-auto max-w-3xl px-5 md:px-8">
    <h2 class="text-3xl font-extrabold tracking-display text-[var(--color-text)] sm:text-4xl lg:text-5xl">
      {c.heading}
    </h2>
    {
      c.intro && (
        <p class="mt-5 text-lg leading-relaxed text-[var(--color-muted)]">
          {c.intro}
        </p>
      )
    }

    <ul class="mt-10 divide-y divide-black/10 border-y border-black/10">
      {
        faqs.map((faq) => (
          <li>
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-semibold text-[var(--color-text)]">
                <span>{faq.q}</span>
                <span
                  aria-hidden="true"
                  class="mt-1 shrink-0 text-2xl font-light text-[var(--color-maroon)] transition-transform group-open:rotate-45"
                >
                  +
                </span>
              </summary>
              <p class="mt-3 pr-10 text-base leading-relaxed text-[var(--color-muted)]">
                {faq.a}
              </p>
            </details>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
