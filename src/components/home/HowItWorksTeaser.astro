---
import { HOME_COPY, type HomeLocale } from "../../lib/home-copy";
import Section from "../kit/Section.astro";
import Steps from "../kit/Steps.astro";
import Arrow from "../kit/Arrow.astro";

interface Props {
  locale?: HomeLocale;
}

const { locale = "en" } = Astro.props;
const c = HOME_COPY[locale].steps;
---

<Section section="steps" title={c.heading} align="center">
  <Steps steps={c.items.map((step) => ({ n: step.n, title: step.title, body: step.body }))} />
  {
    c.more && (
      <p class="mt-8 text-center">
        <a href={c.more.href} class="link inline-flex items-center gap-1.5">
          {c.more.label} <Arrow />
        </a>
      </p>
    )
  }
</Section>
