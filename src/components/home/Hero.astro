---
import PageHero from "../kit/PageHero.astro";
import HeroCopy from "../kit/HeroCopy.astro";
import StoreBadges from "../kit/StoreBadges.astro";
import PhoneMockup from "../kit/PhoneMockup.astro";
import { coverage } from "../../lib/rates";
import { HOME_COPY, fill, type HomeLocale } from "../../lib/home-copy";

interface Props {
  locale?: HomeLocale;
}

const { locale = "en" } = Astro.props;
const c = HOME_COPY[locale].hero;
const utm = HOME_COPY[locale].utmPrefix;
const countries = await coverage();
---

<!--
  Showcase layout (design-system/kalum/MASTER.md §2): the app's own dial
  screen hangs over the wave, so the app's wave header meets the page's.
-->
<PageHero variant="showcase">
  <HeroCopy eyebrow={c.eyebrow} title={c.headline} accent={c.headlineAccent} lead={fill(c.body, countries)} />
  <StoreBadges utm={`${utm}-hero`} class="mt-8" />
  <p class="mt-4 text-sm text-white/70">
    {c.note}
  </p>
  <PhoneMockup slot="card" alt={c.imageAlt} />
</PageHero>
