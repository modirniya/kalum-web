---
import { Image } from "astro:assets";
import icon from "../assets/kalum-icon.jpg";
import { languageSwitch, localeOf } from "../lib/i18n";
import { CHROME } from "../lib/chrome";

// Chrome strings come from src/lib/chrome.ts, keyed by the page's locale.
// The language link is a single link — English from any localized page,
// Spanish from English. Pages that exist in many languages carry their own
// LanguageBar; see the note on languageSwitch() in src/lib/i18n.ts.
//
// Styled as the top of the app (design-system/kalum/MASTER.md §2): the same
// maroon as the hero below it, so header and hero read as one wave header,
// and "Get the app" as the app's cream selected-tab pill.
const path = Astro.url.pathname;
const locale = localeOf(path);
const t = CHROME[locale];
const sw = languageSwitch(path);
const switchLabel = t.switchTo(sw.hreflang === "es" ? "es" : "en");

// The download link on the English home is an in-page anchor; every other
// locale points at its own home so the reader lands on a page that speaks
// their language.
const downloadHref = locale === "en" ? "/#download" : t.home;
---

<header class="sticky top-0 z-30 bg-[var(--color-brand)] text-white">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 md:h-[4.5rem] md:px-8">
    <a href={t.home} class="flex min-h-11 items-center gap-3" aria-label={t.homeLabel}>
      <Image
        src={icon}
        alt="Kalum"
        width={36}
        height={36}
        densities={[1, 2, 3]}
        class="size-9 rounded-lg bg-white p-0.5"
      />
      <span class="text-lg font-extrabold tracking-[0.18em]">KALUM</span>
    </a>

    <nav class="hidden items-center gap-7 text-sm font-medium md:flex">
      {t.nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "transition-colors hover:text-white",
            path.startsWith(item.href) ? "text-white" : "text-white/80",
          ]}
          aria-current={path.startsWith(item.href) ? "page" : undefined}
        >{item.label}</a>
      ))}
      <a
        href={sw.href}
        hreflang={sw.hreflang}
        aria-label={switchLabel}
        class="font-semibold text-white/70 transition-colors hover:text-white"
      >
        {sw.label}
      </a>
      <a
        href={downloadHref}
        rel="noopener"
        class="inline-flex min-h-10 items-center rounded-full bg-[var(--color-pill)] px-5 font-bold text-[var(--color-on-pill)] transition hover:bg-white"
      >
        {t.download}
      </a>
    </nav>

    <details class="group md:hidden">
      <summary
        class="-me-2 grid size-11 cursor-pointer list-none place-items-center rounded-full transition-colors hover:bg-white/10 [&::-webkit-details-marker]:hidden"
        aria-label={t.menu}
      >
        <svg class="group-open:hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
        <svg class="hidden group-open:block" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </summary>
      <div class="absolute inset-x-3 top-full mt-1 rounded-2xl bg-[var(--color-brand-deep)] p-3 shadow-[var(--shadow-float)] ring-1 ring-white/10">
        {t.nav.map((item) => (
          <a href={item.href} class="flex min-h-12 items-center rounded-xl px-4 font-medium text-white/90 hover:bg-white/10">{item.label}</a>
        ))}
        <a
          href={sw.href}
          hreflang={sw.hreflang}
          aria-label={switchLabel}
          class="flex min-h-12 items-center rounded-xl px-4 font-semibold text-white/70 hover:bg-white/10"
        >
          {sw.label}
        </a>
        <a
          href={downloadHref}
          rel="noopener"
          class="mt-2 flex min-h-12 items-center justify-center rounded-full bg-[var(--color-pill)] px-4 font-bold text-[var(--color-on-pill)]"
        >
          {t.download}
        </a>
      </div>
    </details>
  </div>
</header>
