---
import BaseLayout from "../layouts/BaseLayout.astro";
import AppStoreBadge from "./AppStoreBadge.astro";
import GooglePlayBadge from "./GooglePlayBadge.astro";
import Breadcrumb from "./Breadcrumb.astro";
import SignupOrigins from "./SignupOrigins.astro";
import { alternatesFor } from "../lib/i18n";
import { coverage } from "../lib/rates";
import {
  HOW_IT_WORKS_COPY,
  type HowItWorksLocale,
} from "../lib/how-it-works-copy";

/**
 * Shared body for every /how-it-works/ page.
 *
 * Replaced two hand-written pages plus components/howitworks/{Steps,FAQ}.astro
 * on 2026-09-19. Those components held their copy inline with no locale seam,
 * which is exactly why the Spanish page could not use them and ended up a
 * hand-written twin that drifted in both directions. Prose lives in
 * src/lib/how-it-works-copy.ts.
 */
interface Props {
  locale: HowItWorksLocale;
}
const { locale } = Astro.props;

const copy = HOW_IT_WORKS_COPY[locale];
const countries = await coverage();
const faqs = copy.faqs(countries);

// The English page shipped without this for months while the Spanish one had
// it. Emitted from the same array the page renders, so the markup and the
// structured data can never disagree.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={`https://kalum.app${copy.path}`}
  lang={locale}
  alternates={alternatesFor(copy.path)}
>
  <!-- Hero -->
  <section data-section="hero" class="brand-gradient relative overflow-hidden text-white">
    <div class="absolute inset-0 opacity-[0.07]" aria-hidden="true">
      <div class="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-white blur-3xl"></div>
      <div class="absolute bottom-0 right-0 h-96 w-96 rounded-full bg-[var(--color-teal)] blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-4xl px-5 py-20 md:px-8 md:py-28">
      <Breadcrumb
        items={[
          { name: copy.crumbHome, href: copy.crumbHomeHref },
          { name: copy.crumbSelf },
        ]}
      />
      <h1 class="mt-5 text-4xl font-extrabold leading-[1.05] tracking-display sm:text-5xl lg:text-6xl">
        {copy.h1}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85 sm:text-xl">
        {copy.intro}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <AppStoreBadge size="lg" utm={copy.utm} />
        <GooglePlayBadge size="lg" utm={copy.utm} />
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="bg-white py-20 md:py-28">
    <div class="mx-auto max-w-4xl px-5 md:px-8">
      <ol data-section="steps" class="space-y-12">
        {
          copy.steps.map((step) => (
            <li class="grid gap-6 md:grid-cols-[auto_1fr] md:gap-10">
              <div
                aria-hidden="true"
                class="text-7xl font-extrabold leading-none text-[var(--color-teal-ink)] md:text-8xl"
              >
                {step.n}
              </div>
              <div>
                <h2 class="text-2xl font-extrabold tracking-display text-[var(--color-text)] sm:text-3xl">
                  {step.title}
                </h2>
                <p class="mt-3 text-lg leading-relaxed text-[var(--color-muted)]">
                  {step.body}
                </p>
                <p class="mt-4 border-l-4 border-[var(--color-maroon)] pl-4 text-base italic text-[var(--color-muted)]">
                  {step.note}
                </p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="mt-14 text-base text-[var(--color-muted)]">
        {copy.ratesLink.lead}
        <a
          href={copy.ratesLink.href}
          class="font-semibold text-[var(--color-maroon)] hover:text-[var(--color-maroon-light)] transition"
        >{copy.ratesLink.label} &rarr;</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section data-section="faq" class="bg-[var(--color-cream)] py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-5 md:px-8">
      <h2 class="text-3xl font-extrabold tracking-display text-[var(--color-text)] sm:text-4xl">
        {copy.faqH2}
      </h2>

      <ul class="mt-10 divide-y divide-black/10 border-y border-black/10">
        {
          faqs.map((faq) => (
            <li>
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-semibold text-[var(--color-text)]">
                  <span>{faq.q}</span>
                  <span
                    aria-hidden="true"
                    class="mt-1 shrink-0 text-2xl font-light text-[var(--color-maroon)] transition-transform group-open:rotate-45"
                  >
                    +
                  </span>
                </summary>
                <p class="mt-3 pr-10 text-base leading-relaxed text-[var(--color-muted)]">
                  {faq.a}
                </p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Final CTA -->
  <section data-section="cta" class="brand-gradient text-white">
    <div class="mx-auto max-w-3xl px-5 py-16 text-center md:px-8 md:py-20">
      <h2 class="text-3xl font-extrabold tracking-display sm:text-4xl">
        {copy.ctaH2}
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-white/85">
        {copy.ctaBody}
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <AppStoreBadge size="lg" utm={copy.utm} />
        <GooglePlayBadge size="lg" utm={copy.utm} />
      </div>
    </div>
  </section>

  <section data-section="origins" class="bg-[var(--color-cream)] py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-5 md:px-8">
      <SignupOrigins locale={locale} />
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>
