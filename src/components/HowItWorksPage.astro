---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "./Breadcrumb.astro";
import SignupOrigins from "./SignupOrigins.astro";
import PageHero from "./kit/PageHero.astro";
import HeroCopy from "./kit/HeroCopy.astro";
import StoreBadges from "./kit/StoreBadges.astro";
import Section from "./kit/Section.astro";
import Steps from "./kit/Steps.astro";
import Faq from "./kit/Faq.astro";
import CtaBand from "./kit/CtaBand.astro";
import Arrow from "./kit/Arrow.astro";
import { alternatesFor } from "../lib/i18n";
import { coverage } from "../lib/rates";
import {
  HOW_IT_WORKS_COPY,
  type HowItWorksLocale,
} from "../lib/how-it-works-copy";

/**
 * Shared body for every /how-it-works/ page.
 *
 * Replaced two hand-written pages plus components/howitworks/{Steps,FAQ}.astro
 * on 2026-09-19. Those components held their copy inline with no locale seam,
 * which is exactly why the Spanish page could not use them and ended up a
 * hand-written twin that drifted in both directions. Prose lives in
 * src/lib/how-it-works-copy.ts.
 *
 * Landing layout (design-system/kalum/MASTER.md §2). The signup-origins card
 * sits before the closing CTA band so the band can run into the footer.
 */
interface Props {
  locale: HowItWorksLocale;
}
const { locale } = Astro.props;

const copy = HOW_IT_WORKS_COPY[locale];
const countries = await coverage();
const faqs = copy.faqs(countries);

// The English page shipped without this for months while the Spanish one had
// it. Emitted from the same array the page renders, so the markup and the
// structured data can never disagree.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={`https://kalum.app${copy.path}`}
  lang={locale}
  alternates={alternatesFor(copy.path)}
>
  <PageHero>
    <Breadcrumb
      items={[
        { name: copy.crumbHome, href: copy.crumbHomeHref },
        { name: copy.crumbSelf },
      ]}
    />
    <HeroCopy title={copy.h1} lead={copy.intro} />
    <StoreBadges utm={copy.utm} class="mt-8" />
  </PageHero>

  <Section width="mid">
    <Steps
      section="steps"
      layout="list"
      steps={copy.steps.map((step) => ({ n: step.n, title: step.title, body: step.body, note: step.note }))}
    />
    <p class="mt-8 text-[var(--color-ink-2)]">
      {copy.ratesLink.lead}
      <a href={copy.ratesLink.href} class="link inline-flex items-center gap-1"
        >{copy.ratesLink.label} <Arrow /></a
      >
    </p>
  </Section>

  <Section section="faq" width="narrow" title={copy.faqH2}>
    <Faq items={faqs} />
  </Section>

  <Section section="origins" width="mid" flush>
    <SignupOrigins locale={locale} />
  </Section>

  <CtaBand title={copy.ctaH2} body={copy.ctaBody} utm={copy.utm} />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>
