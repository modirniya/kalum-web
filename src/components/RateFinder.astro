---
/**
 * Country rate finder.
 *
 * Deliberately asks **where**, not **who**: there is no phone number field
 * anywhere in this component, and no phone number ever reaches a server. The
 * visitor picks a country and the price is resolved in the browser from the
 * card already baked into this page at build time, so the answer needs no
 * network call, has no loading state and cannot fail.
 */
import type { RateCard } from "../lib/rates";
import { fromPrefix, formatRatesAsOf, coverageFloor } from "../lib/rates";
import { finderRows } from "../lib/rate-finder";

interface Props {
  card: RateCard;
  locale?: "en" | "es";
  /** Dial code → translated country name, for destinations that have one. */
  localNames?: Record<string, string>;
  /**
   * Render the component's own heading and sub-line.
   *
   * Off when the surrounding section already supplies an `<h2>` — two headings
   * in one section is a document-outline bug, not a style preference.
   */
  showHeading?: boolean;
  class?: string;
}

const {
  card,
  locale = "en",
  localNames = {},
  showHeading = true,
  class: klass = "",
} = Astro.props;

const rows = finderRows(card, localNames);
// Same floored figure the rest of the site quotes, so the box and the copy
// beside it never show two different numbers.
const shownCount = coverageFloor(card);
const from = fromPrefix(card.basis, locale);
const asOf = formatRatesAsOf(card.fetchedAt, locale);

const t =
  locale === "es"
    ? {
        heading: "¿A dónde llamas?",
        sub: "Elige un destino para ver la tarifa. Sin registro, sin número de teléfono.",
        placeholder: `Busca entre ${shownCount}+ destinos…`,
        search: "Buscar destinos",
        popular: "Populares:",
        idle: "Elige un destino y la tarifa aparece aquí.",
        none: "Ningún destino coincide. Prueba con el nombre del país o su código.",
        perMin: "/min",
        note: "Se cobra por minuto de tu saldo prepago. La app confirma la tarifa exacta del número antes de conectar la llamada.",
        asOf: `Tarifas actualizadas el ${asOf}.`,
        rateLabel: "Tarifa",
      }
    : {
        heading: "Where are you calling?",
        sub: "Pick a destination to see the rate. No sign-up, no phone number.",
        placeholder: `Search ${shownCount}+ destinations…`,
        search: "Search destinations",
        popular: "Popular:",
        idle: "Choose a destination and the rate appears here.",
        none: "No destination matches that. Try a country name or a dial code.",
        perMin: "/min",
        note: "Billed by the minute from your prepaid balance. The app confirms the exact rate for a specific number before the call connects.",
        asOf: `Rates updated ${asOf}.`,
        rateLabel: "Rate",
      };

// Quick picks, by dial code. Chosen from the curated destination set so they
// always resolve; a code missing from the card is skipped at render.
const popularCodes = ["52", "91", "234", "63", "20"];
const popular = popularCodes
  .map((code) => rows.find((r) => r[0] === code))
  .filter((r): r is (typeof rows)[number] => Boolean(r));
---

<div
  class:list={["rounded-2xl border border-black/5 bg-white shadow-sm", klass]}
  data-rate-finder
>
  <div class="grid gap-0 md:grid-cols-[1fr_20rem]">
    <div class="p-6 md:p-8">
      {
        showHeading && (
          <>
            <h2 class="text-xl font-extrabold tracking-display text-[var(--color-text)]">
              {t.heading}
            </h2>
            <p class="mt-1 text-sm text-[var(--color-muted)]">{t.sub}</p>
          </>
        )
      }

      <form class:list={[showHeading ? "mt-5" : ""]} data-finder-form novalidate>
        <label for="rate-finder-q" class="sr-only">{t.search}</label>
        <input
          id="rate-finder-q"
          type="text"
          role="combobox"
          aria-expanded="false"
          aria-controls="rate-finder-results"
          aria-autocomplete="list"
          autocomplete="off"
          spellcheck="false"
          placeholder={t.placeholder}
          data-finder-input
          class="w-full rounded-md border border-black/10 bg-white px-4 py-3 text-base text-[var(--color-text)] placeholder:text-[var(--color-muted)] outline-none focus:border-[var(--color-maroon)] focus:ring-2 focus:ring-[var(--color-maroon)]/30"
        />
      </form>

      <div
        id="rate-finder-results"
        role="listbox"
        aria-label={t.search}
        data-finder-results
        class="mt-2 max-h-60 overflow-y-auto rounded-md border border-black/10 empty:hidden"
      >
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="text-xs text-[var(--color-muted)]">{t.popular}</span>
        {
          popular.map((r) => (
            <button
              type="button"
              data-finder-chip={r[0]}
              class="rounded-full border border-black/10 bg-[var(--color-cream)] px-3 py-1 text-sm text-[var(--color-text)] transition hover:border-[var(--color-maroon)]/40 hover:text-[var(--color-maroon)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-maroon)]/40"
            >
              {r[1]}
            </button>
          ))
        }
      </div>
    </div>

    <aside
      class="flex flex-col border-t border-black/5 bg-[var(--color-cream)] p-6 md:border-t-0 md:border-l md:p-8"
    >
      <p
        class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-[var(--color-muted)]"
      >
        {t.rateLabel}
      </p>
      <div class="mt-3" data-finder-readout>
        <p class="text-sm leading-relaxed text-[var(--color-muted)]">{t.idle}</p>
      </div>
      <p class="mt-auto pt-6 text-xs text-[var(--color-muted)]">{t.asOf}</p>
    </aside>
  </div>

  <script is:inline type="application/json" data-finder-data set:html={JSON.stringify(rows)} />
  <script
    is:inline
    type="application/json"
    data-finder-copy
    set:html={JSON.stringify({
      none: t.none,
      perMin: t.perMin,
      note: t.note,
      from: from,
    })}
  />
</div>

<script>
  // Runs once per finder on the page. Everything here is progressive
  // enhancement: with JS off the page still shows its static rate grid, which
  // is what the crawlers read anyway.
  document.querySelectorAll<HTMLElement>("[data-rate-finder]").forEach((root) => {
    const dataEl = root.querySelector<HTMLScriptElement>("[data-finder-data]");
    const copyEl = root.querySelector<HTMLScriptElement>("[data-finder-copy]");
    const input = root.querySelector<HTMLInputElement>("[data-finder-input]");
    const list = root.querySelector<HTMLElement>("[data-finder-results]");
    const readout = root.querySelector<HTMLElement>("[data-finder-readout]");
    const form = root.querySelector<HTMLFormElement>("[data-finder-form]");
    if (!dataEl || !copyEl || !input || !list || !readout || !form) return;

    type Row = [string, string, number];
    const rows: Row[] = JSON.parse(dataEl.textContent || "[]");
    const copy = JSON.parse(copyEl.textContent || "{}") as {
      none: string;
      perMin: string;
      note: string;
      from: string;
    };

    let shown: Row[] = [];
    let cursor = -1;

    const money = (c: number) => (c >= 100 ? `$${(c / 100).toFixed(2)}` : `${c}¢`);
    const esc = (s: string) =>
      s.replace(
        /[&<>"']/g,
        (m) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[m] as string
      );

    function close() {
      list!.innerHTML = "";
      input!.setAttribute("aria-expanded", "false");
      cursor = -1;
    }

    function filter(term: string): Row[] {
      const t = term.trim().toLowerCase().replace(/^\+/, "");
      if (!t) return [];
      const byName: Row[] = [];
      const byCode: Row[] = [];
      const contains: Row[] = [];
      for (const r of rows) {
        const n = r[1].toLowerCase();
        if (n.startsWith(t)) byName.push(r);
        else if (r[0].startsWith(t)) byCode.push(r);
        else if (n.includes(t)) contains.push(r);
      }
      return byName.concat(byCode, contains);
    }

    function render(items: Row[]) {
      shown = items.slice(0, 60);
      cursor = -1;
      if (!input!.value.trim()) return close();
      if (!shown.length) {
        list!.innerHTML = `<p class="px-4 py-3 text-sm text-[var(--color-muted)]">${esc(copy.none)}</p>`;
        input!.setAttribute("aria-expanded", "true");
        return;
      }
      list!.innerHTML = shown
        .map(
          (r, i) =>
            `<button type="button" role="option" aria-selected="false" data-i="${i}" ` +
            `class="flex w-full items-center gap-3 border-b border-black/5 px-4 py-2.5 text-left last:border-b-0 hover:bg-[var(--color-cream)] aria-selected:bg-[var(--color-cream)]">` +
            `<span class="min-w-[3.5rem] text-sm font-semibold text-[var(--color-maroon)] tabular-nums">+${esc(r[0])}</span>` +
            `<span class="flex-1 truncate text-sm text-[var(--color-text)]">${esc(r[1])}</span>` +
            `<span class="text-sm text-[var(--color-muted)] tabular-nums">${money(r[2])}</span>` +
            `</button>`
        )
        .join("");
      input!.setAttribute("aria-expanded", "true");
    }

    function choose(r: Row) {
      readout!.innerHTML =
        `<p class="text-sm font-semibold text-[var(--color-text)]">${esc(r[1])}</p>` +
        `<p class="mt-0.5 text-sm text-[var(--color-maroon)] tabular-nums">+${esc(r[0])}</p>` +
        `<p class="mt-4 flex items-baseline gap-1.5">` +
        (copy.from
          ? `<span class="text-sm font-semibold text-[var(--color-muted)]">${esc(copy.from.trim())}</span>`
          : "") +
        `<span class="text-4xl font-extrabold tracking-display text-[var(--color-maroon)] tabular-nums">${money(r[2])}</span>` +
        `<span class="text-sm text-[var(--color-muted)]">${esc(copy.perMin)}</span>` +
        `</p>` +
        `<p class="mt-3 text-xs leading-relaxed text-[var(--color-muted)]">${esc(copy.note)}</p>`;
      input!.value = r[1];
      close();
    }

    input.addEventListener("input", () => render(filter(input.value)));

    input.addEventListener("keydown", (e) => {
      const opts = list!.querySelectorAll<HTMLButtonElement>("[data-i]");
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        if (!opts.length) return;
        e.preventDefault();
        cursor += e.key === "ArrowDown" ? 1 : -1;
        if (cursor < 0) cursor = opts.length - 1;
        if (cursor >= opts.length) cursor = 0;
        opts.forEach((o, i) => o.setAttribute("aria-selected", i === cursor ? "true" : "false"));
        opts[cursor].scrollIntoView({ block: "nearest" });
      } else if (e.key === "Escape") {
        close();
      }
    });

    // Enter selects the highlighted result, or the first one if none is
    // highlighted; a click on a result calls choose() directly.
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (cursor >= 0 && shown[cursor]) choose(shown[cursor]);
      else if (shown.length) choose(shown[0]);
    });

    list.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-i]");
      if (btn) choose(shown[Number(btn.dataset.i)]);
    });

    root.querySelectorAll<HTMLButtonElement>("[data-finder-chip]").forEach((chip) => {
      chip.addEventListener("click", () => {
        const r = rows.find((x) => x[0] === chip.dataset.finderChip);
        if (r) choose(r);
      });
    });

    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) close();
    });
  });
</script>
