---
// Breadcrumb for use inside a brand-gradient hero. Renders the visible nav
// AND the matching BreadcrumbList JSON-LD from ONE items array, so markup and
// structured data can never disagree (matters given the prior cloaking flag).
// The last item is the current page: pass it without an href.
interface Item {
  name: string;
  href?: string;
}
interface Props {
  items: Item[];
  /**
   * Which ground the trail sits on. The default is the brand-gradient hero
   * this was written for; `light` is for the cream sections (the /call/ and
   * /how-it-works/ hubs), where the white variant would be invisible. Never
   * render the JSON-LD without its visible counterpart — one array feeds
   * both precisely so they cannot disagree.
   */
  tone?: "dark" | "light";
}
const { items, tone = "dark" } = Astro.props;

const ink =
  tone === "dark"
    ? { base: "text-white/70", sep: "text-white/40", here: "text-white/90", hover: "hover:text-white" }
    : {
        base: "text-[var(--color-muted)]",
        sep: "text-[var(--color-muted)]/50",
        here: "text-[var(--color-text)]",
        hover: "hover:text-[var(--color-maroon)]",
      };

const SITE = "https://kalum.app";
const jsonld = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((it, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: it.name,
    ...(it.href ? { item: `${SITE}${it.href}` } : {}),
  })),
};
---

<nav aria-label="Breadcrumb" class:list={["mb-6 text-sm", ink.base]}>
  <ol class="flex flex-wrap items-center gap-x-2">
    {
      items.map((it, i) => (
        <>
          {i > 0 && <li aria-hidden="true" class={ink.sep}>/</li>}
          <li>
            {it.href ? (
              <a href={it.href} class:list={[ink.hover, "transition"]}>{it.name}</a>
            ) : (
              <span aria-current="page" class={ink.here}>{it.name}</span>
            )}
          </li>
        </>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
