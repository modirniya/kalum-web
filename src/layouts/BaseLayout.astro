---
import "@fontsource-variable/plus-jakarta-sans";
import "../styles/global.css";

// One variable file carries the whole 200-800 range, so a single preload covers
// every weight the site renders — including the 600 on the above-the-fold
// eyebrow, which the old five-static-weights setup left to a late discovery.
// Non-Latin subsets stay on demand behind their unicode-range.
import jakartaLatin from "@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url";

// Faces for the scripts Plus Jakarta Sans does not carry. Importing all four
// here costs a few hundred bytes of @font-face CSS on every page and no font
// bytes at all: each declaration is fenced by unicode-range, so a browser only
// fetches a file when the page actually contains that script. Which face a
// page uses is set per <html lang> in global.css; the preload below is the
// one exception, pulled forward on the page that will paint with it.
import "@fontsource-variable/noto-sans-arabic";
import "@fontsource-variable/noto-nastaliq-urdu";
import "@fontsource-variable/noto-sans-devanagari";
import "@fontsource-variable/noto-sans-bengali";
import notoArabic from "@fontsource-variable/noto-sans-arabic/files/noto-sans-arabic-arabic-wght-normal.woff2?url";
import notoNastaliq from "@fontsource-variable/noto-nastaliq-urdu/files/noto-nastaliq-urdu-arabic-wght-normal.woff2?url";
import notoDevanagari from "@fontsource-variable/noto-sans-devanagari/files/noto-sans-devanagari-devanagari-wght-normal.woff2?url";
import notoBengali from "@fontsource-variable/noto-sans-bengali/files/noto-sans-bengali-bengali-wght-normal.woff2?url";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { storeUrls } from "../lib/stores";
import { LOCALES, type Alternate, type Locale } from "../lib/i18n";
import { coverage } from "../lib/rates";

const countries = await coverage();

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  /** Add <meta name="robots" content="noindex"> — for paid-traffic-only pages. */
  noindex?: boolean;
  /** Omit the site-wide Header and Footer (focused landing pages). */
  bare?: boolean;
  /** Page language. Drives <html lang>, og:locale, inLanguage, and the font. */
  lang?: Locale;
  /** Text direction. Pass LOCALES[lang].dir; defaults to ltr. */
  dir?: "ltr" | "rtl";
  /** hreflang alternates from alternatesFor(); omit for single-locale pages. */
  alternates?: Alternate[];
  /**
   * Drop the app-marketing furniture: the Smart App Banner meta and the
   * MobileApplication node. For pages that are not about the app and do not
   * canonicalise to this site — /privacy/ and /terms/, whose canonical points
   * at legal.neuera.app. Organization and WebSite stay: they describe the
   * publisher, which is true on any page.
   */
  minimal?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = "/og-default.png",
  noindex = false,
  bare = false,
  lang = "en",
  dir = "ltr",
  alternates,
  minimal = false,
} = Astro.props;

/**
 * Snippet budget, checked at build time.
 *
 * Google cuts the title around 60 characters and the description around 155
 * on mobile. The 2026-09-19 audit found 43 of 59 pages over the description
 * limit and 10 over the title limit — and what fell past the cut was the
 * clause each page had been written to be clicked on, while the pages sat at
 * position 8-9 taking no clicks at all.
 *
 * Every page on the site renders through this layout, so one check here is
 * the whole site's guard. It WARNS and never throws: an over-long snippet is
 * a lost click, not a broken page, and failing the build over a typo would
 * take the site down to fix a cosmetic regression. Read the warnings in the
 * deploy log (or `npm run build 2>&1 | grep snippet`).
 */
const TITLE_BUDGET = 60;
const DESCRIPTION_BUDGET = 155;
if (title.length > TITLE_BUDGET) {
  console.warn(
    `[snippet] title ${title.length}/${TITLE_BUDGET} — ${canonical}`,
  );
}
if (description.length > DESCRIPTION_BUDGET) {
  console.warn(
    `[snippet] description ${description.length}/${DESCRIPTION_BUDGET} — ${canonical}`,
  );
}

const siteUrl = "https://kalum.app";
const absoluteOg = ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`;
const ogLocale = LOCALES[lang].ogLocale;

// The locale's script font, preloaded so the hero paints in it rather than in
// a fallback that then swaps. Null for Latin-script locales, which are already
// covered by the Jakarta preload above.
const scriptFonts = {
  arabic: notoArabic,
  nastaliq: notoNastaliq,
  devanagari: notoDevanagari,
  bengali: notoBengali,
};
const face = LOCALES[lang].font;
const scriptFont = face ? scriptFonts[face] : null;

// storeUrls (clean canonical listing URLs) come from src/lib/stores.ts —
// the same source the download badges use, so the two never drift apart.

// Site-wide structured data. Claims kept to verified facts only — no ratings
// or invented figures.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "Kalum",
      url: siteUrl,
      logo: `${siteUrl}/apple-touch-icon.png`,
      sameAs: storeUrls,
      parentOrganization: { "@type": "Organization", name: "Neuera" },
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "Kalum",
      publisher: { "@id": `${siteUrl}/#organization` },
      inLanguage: lang,
    },
    ...(minimal ? [] : [{
      "@type": "MobileApplication",
      name: "Kalum: Call Abroad over WiFi",
      operatingSystem: "iOS, Android",
      applicationCategory: "CommunicationApplication",
      url: siteUrl,
      sameAs: storeUrls,
      installUrl: storeUrls,
      publisher: { "@id": `${siteUrl}/#organization` },
      // The app is free; $4.99 is the minimum credit top-up, not a price.
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
    }]),
  ],
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#420905" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      alternates?.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }

    <link rel="preload" href={jakartaLatin} as="font" type="font/woff2" crossorigin />
    {scriptFont && <link rel="preload" href={scriptFont} as="font" type="font/woff2" crossorigin />}

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {
      !minimal && (
        <meta name="apple-itunes-app" content={`app-id=6763210844, app-argument=${canonical}`} />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kalum" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`Kalum — cheap international calls to any phone in ${countries}+ countries`}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-cream)] text-[var(--color-text)]">
    {!bare && <Header />}
    <main class="flex-1">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
