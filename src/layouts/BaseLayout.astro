---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "../styles/global.css";

// Preload the two above-the-fold Latin subsets (body 400, headings 800) so
// the browser fetches them before it discovers them in the @fontsource CSS —
// cuts LCP/FOUT. Other weights/subsets load on demand via the CSS above.
import interLatin400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import interLatin800 from "@fontsource/inter/files/inter-latin-800-normal.woff2?url";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { storeUrls } from "../lib/stores";
import type { Alternate } from "../lib/i18n";
import { coverage } from "../lib/rates";

const countries = await coverage();

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  /** Add <meta name="robots" content="noindex"> — for paid-traffic-only pages. */
  noindex?: boolean;
  /** Omit the site-wide Header and Footer (focused landing pages). */
  bare?: boolean;
  /** Page language (BCP-47). Drives <html lang>, og:locale, inLanguage. */
  lang?: string;
  /** Text direction — "rtl" for Arabic, when it lands. */
  dir?: "ltr" | "rtl";
  /** hreflang alternates from alternatesFor(); omit for single-locale pages. */
  alternates?: Alternate[];
}

const {
  title,
  description,
  canonical,
  ogImage = "/og-default.png",
  noindex = false,
  bare = false,
  lang = "en",
  dir = "ltr",
  alternates,
} = Astro.props;

const siteUrl = "https://kalum.app";
const absoluteOg = ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`;
const ogLocale = lang === "es" ? "es_MX" : "en_US";

// storeUrls (clean canonical listing URLs) come from src/lib/stores.ts —
// the same source the download badges use, so the two never drift apart.

// Site-wide structured data. Claims kept to verified facts only — no ratings
// or invented figures.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "Kalum",
      url: siteUrl,
      logo: `${siteUrl}/apple-touch-icon.png`,
      sameAs: storeUrls,
      parentOrganization: { "@type": "Organization", name: "Neuera" },
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "Kalum",
      publisher: { "@id": `${siteUrl}/#organization` },
      inLanguage: lang,
    },
    {
      "@type": "MobileApplication",
      name: "Kalum: Call Abroad over WiFi",
      operatingSystem: "iOS, Android",
      applicationCategory: "CommunicationApplication",
      url: siteUrl,
      sameAs: storeUrls,
      installUrl: storeUrls,
      publisher: { "@id": `${siteUrl}/#organization` },
      // The app is free; $4.99 is the minimum credit top-up, not a price.
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
    },
  ],
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#420905" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      alternates?.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }

    <link rel="preload" href={interLatin400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin800} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta name="apple-itunes-app" content={`app-id=6763210844, app-argument=${canonical}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kalum" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`Kalum — cheap international calls to any phone in ${countries}+ countries`}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-cream)] text-[var(--color-text)]">
    {!bare && <Header />}
    <main class="flex-1">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
